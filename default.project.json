          "$className": "RemoteEvent"
        },
        "SetCrouch": {
          "$className": "RemoteEvent"
        },
        "RequestReplay": {
          "$className": "RemoteEvent"
        },
        "InventoryChanged": {
          "$className": "RemoteEvent"
        },
        "Toast": {
          "$className": "RemoteEvent"
        },
        "Dialogue": {
          "$className": "RemoteEvent"
        },
        "ShowNote": {
          "$className": "RemoteEvent"
        },
        "CameraShake": {
          "$className": "RemoteEvent"
        },
        "RunComplete": {
          "$className": "RemoteEvent"
        },
        "ChangeOutfit": {
          "$className": "RemoteEvent"
        }
      }
