      <Item class="Folder" referent="48">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
-- ClientState: small shared table so client controllers can read each
-- other's local values (for example, the HUD shows the stamina that the
-- MovementController simulates). Nothing here is trusted by the server.

local ClientState = {
	Stamina = 100,
	Crouching = false,
	-- 0 = the Rift Stalker is far away, 1 = it is right next to you.
	Danger = 0,
	-- True while a full-screen panel (note, end screen) is open.
	ModalOpen = false,
}

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="50">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">AtmosphereController</string>
              <string name="Source"><![CDATA[--!strict
-- AtmosphereController: local-only mood effects. Rain around the camera,
-- lightning flashes, camera shake, and a "danger" value that rises as the
-- Rift Stalker gets close (the HUD turns it into a pulsing edge glow so the threat
-- is readable, not a cheap surprise).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local ClientState = require(script.Parent.Parent.ClientState)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local AtmosphereController = {}

local shakeUntil = 0
local shakeIntensity = 0
local rng = Random.new()

-- Plays a configured sound if an ID has been set (see Config.Sounds).
local function makeSound(id: string, looped: boolean, volume: number): Sound?
	if id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Looped = looped
	sound.Volume = volume
	sound.Parent = SoundService
	return sound
end

-- Inside the temple and tunnel there is a roof, so no rain or lightning.
local function isIndoors(position: Vector3): boolean
	return position.Z > 298 and position.Z < 432 and position.Y < 24
end

local function createRain(): ParticleEmitter
	local emitterPart = Instance.new("Part")
	emitterPart.Name = "RainEmitter"
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	emitterPart.CanTouch = false
	emitterPart.Transparency = 1
	emitterPart.Size = Vector3.new(90, 1, 90)
	emitterPart.Parent = workspace.CurrentCamera

	local rain = Instance.new("ParticleEmitter")
	rain.Name = "Rain"
	rain.Shape = Enum.ParticleEmitterShape.Box
	rain.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Rate = 700
	rain.Lifetime = NumberRange.new(0.8, 1.1)
	rain.Speed = NumberRange.new(70, 85)
	rain.Size = NumberSequence.new(0.07)
	rain.Squash = NumberSequence.new(3) -- Stretch drops into streaks.
	rain.Orientation = Enum.ParticleOrientation.VelocityParallel
	rain.Transparency = NumberSequence.new(0.55)
	rain.Color = ColorSequence.new(Color3.fromRGB(170, 190, 210))
	rain.LightInfluence = 0.6
	rain.Parent = emitterPart
	return rain
end

-- A jagged bolt in the sky, briefly visible during a flash.
local function drawBolt()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z).Unit
	local side = Vector3.new(-flat.Z, 0, flat.X)
	local point = camera.CFrame.Position + flat * 170 + side * rng:NextNumber(-90, 90) + Vector3.new(0, 150, 0)
	local folder = Instance.new("Folder")
	folder.Name = "LightningBolt"
	while point.Y > 30 do
		local nextPoint = point + Vector3.new(rng:NextNumber(-10, 10), -rng:NextNumber(14, 24), rng:NextNumber(-10, 10))
		local segment = Instance.new("Part")
		segment.Anchored = true
		segment.CanCollide = false
		segment.CanQuery = false
		segment.CanTouch = false
		segment.CastShadow = false
		segment.Material = Enum.Material.Neon
		segment.Color = Color3.fromRGB(210, 220, 255)
		segment.Size = Vector3.new(0.9, 0.9, (nextPoint - point).Magnitude)
		segment.CFrame = CFrame.lookAt((point + nextPoint) / 2, nextPoint)
		segment.Parent = folder
		point = nextPoint
	end
	folder.Parent = camera
	task.delay(0.22, function()
		folder:Destroy()
	end)
end

local function flashLightning()
	drawBolt()
	local original = Lighting.OutdoorAmbient
	local originalBrightness = Lighting.Brightness
	for _ = 1, rng:NextInteger(1, 2) do
		Lighting.OutdoorAmbient = Color3.fromRGB(150, 160, 190)
		Lighting.Brightness = 2.5
		task.wait(0.07)
		Lighting.OutdoorAmbient = original
		Lighting.Brightness = originalBrightness
		task.wait(0.1)
	end
end

function AtmosphereController.Init()
	local rain = createRain()
	local rainSound = makeSound(Config.Sounds.Rain, true, 0.4)
	if rainSound then
		rainSound:Play()
	end
	local heartbeat = makeSound(Config.Sounds.Heartbeat, true, 0)
	if heartbeat then
		heartbeat:Play()
	end
	local thunder = makeSound(Config.Sounds.Thunder, false, 0.6)
	local rumble = makeSound(Config.Sounds.Rumble, false, 0.7)

	Remotes.CameraShake.OnClientEvent:Connect(function(duration: number, intensity: number)
		if type(duration) ~= "number" or type(intensity) ~= "number" then
			return
		end
		shakeUntil = math.max(shakeUntil, os.clock() + duration)
		shakeIntensity = math.max(intensity, if os.clock() < shakeUntil then shakeIntensity else 0)
		if rumble and duration > 1 then
			rumble:Play()
		end
	end)

	-- Rain follows the camera.
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		local emitterPart = rain.Parent
		if not camera or not emitterPart or not emitterPart:IsA("BasePart") then
			return
		end
		local pos = camera.CFrame.Position
		emitterPart.CFrame = CFrame.new(pos + Vector3.new(0, 35, 0))
		rain.Enabled = not isIndoors(pos)
		if rainSound then
			rainSound.Volume = if isIndoors(pos) then 0.1 else 0.4
		end
	end)

	-- Camera shake runs after the default camera has moved this frame.
	RunService:BindToRenderStep("RiftfallShake", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		if now >= shakeUntil then
			return
		end
		local camera = workspace.CurrentCamera
		local strength = shakeIntensity * math.clamp((shakeUntil - now) / 0.5, 0, 1)
		camera.CFrame *= CFrame.Angles(
			math.rad(rng:NextNumber(-1, 1) * strength),
			math.rad(rng:NextNumber(-1, 1) * strength),
			0
		)
	end)

	-- Danger meter: how close is the Rift Stalker?
	task.spawn(function()
		while true do
			task.wait(0.15)
			local stalker = workspace:FindFirstChild("RiftStalker")
			local character = player.Character
			local myRoot = character and character:FindFirstChild("HumanoidRootPart")
			local stalkerRoot = stalker and stalker:FindFirstChild("HumanoidRootPart")
			if myRoot and myRoot:IsA("BasePart") and stalkerRoot and stalkerRoot:IsA("BasePart") then
				local distance = (myRoot.Position - stalkerRoot.Position).Magnitude
				ClientState.Danger = math.clamp(1 - (distance - 8) / 32, 0, 1)
			else
				ClientState.Danger = 0
			end
			if heartbeat then
				heartbeat.Volume = ClientState.Danger * 0.8
			end
		end
	end)

	-- Lightning every so often while outdoors.
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(14, 30))
			local camera = workspace.CurrentCamera
			if camera and not isIndoors(camera.CFrame.Position) then
				flashLightning()
				if thunder then
					task.wait(rng:NextNumber(0.4, 1.5))
					thunder:Play()
				end
			end
		end
	end)
end

return AtmosphereController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">FlashlightController</string>
              <string name="Source"><![CDATA[--!strict
-- FlashlightController: press F (or the on-screen button) to ask the server
-- to toggle your flashlight. The server decides whether it is on (battery).
--
-- What you see yourself is a local light and beam aimed exactly where your
-- camera looks, which makes the flashlight easy to point. The server's copy on
-- your head (which other players see) is hidden on your own screen so the
-- two don't double up.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FlashlightVisuals = require(ReplicatedStorage.Shared.FlashlightVisuals)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local FlashlightController = {}

local function onToggle(_: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	if inputState == Enum.UserInputState.Begin then
		Remotes.ToggleFlashlight:FireServer()
	end
	return Enum.ContextActionResult.Sink
end

local function createLocalTorch(): (BasePart, FlashlightVisuals.Rig)
	local torch = Instance.new("Part")
	torch.Name = "LocalFlashlight"
	torch.Size = Vector3.new(0.2, 0.2, 0.2)
	torch.Transparency = 1
	torch.Anchored = true
	torch.CanCollide = false
	torch.CanQuery = false
	torch.CanTouch = false
	torch.CastShadow = false
	torch.Parent = workspace.CurrentCamera
	return torch, FlashlightVisuals.Create(torch, 0.3)
end

-- Keeps the replicated head light switched off on this screen only.
local function hideOwnHeadLight(head: Instance)
	for _, name in { "Flashlight", "FlashlightBeam", "FlashlightGlow" } do
		local inst = head:FindFirstChild(name)
		if inst and (inst:IsA("Light") or inst:IsA("Beam")) and inst.Enabled then
			inst.Enabled = false
		end
	end
end

function FlashlightController.Init()
	ContextActionService:BindAction("RiftfallFlashlight", onToggle, true, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("RiftfallFlashlight", "Light")
	ContextActionService:SetPosition("RiftfallFlashlight", UDim2.new(1, -110, 1, -210))

	local torch, rig = createLocalTorch()
	local wasOn = false

	RunService.RenderStepped:Connect(function()
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local camera = workspace.CurrentCamera
		if torch.Parent ~= camera and camera then
			torch.Parent = camera -- The camera can be replaced on respawn.
		end
		local on = player:GetAttribute("FlashlightOn") == true
			and head ~= nil
			and head:IsA("BasePart")
			and humanoid ~= nil
			and humanoid.Health > 0
		if on ~= wasOn then
			FlashlightVisuals.SetEnabled(rig, on)
			wasOn = on
		end
		if head and head:IsA("BasePart") then
			hideOwnHeadLight(head)
			if on and camera then
				local look = camera.CFrame.LookVector
				-- Held slightly in front of and below the eyes.
				local origin = head.Position + look * 0.8 - Vector3.new(0, 0.3, 0)
				torch.CFrame = CFrame.lookAt(origin, origin + look)
			end
		end
	end)
end

return FlashlightController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
-- HUDController: builds and updates all on-screen UI in code.
--
--   top-left       current objective
--   top-center     short messages ("Picked up Battery", "Checkpoint reached")
--   bottom-left    health, flashlight battery, stamina
--   bottom-center  inventory (click/tap a slot or press 1-4 to use it; the
--                  small X drops it) and radio subtitles above it
--   screen edges   red flash when hurt, dark pulse when the Rift Stalker is near
--   full screen    note reader, death screen, end-of-demo results

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local Story = require(ReplicatedStorage.Shared.Story)
local CharacterDesigns = require(ReplicatedStorage.Shared.CharacterDesigns)
local ClientState = require(script.Parent.Parent.ClientState)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local HUDController = {}

local COLORS = {
	Panel = Color3.fromRGB(12, 14, 16),
	Text = Color3.fromRGB(232, 226, 212),
	Muted = Color3.fromRGB(160, 156, 146),
	Accent = Color3.fromRGB(190, 110, 255),
	Health = Color3.fromRGB(200, 60, 60),
	Battery = Color3.fromRGB(110, 190, 255),
	Stamina = Color3.fromRGB(220, 220, 210),
	Good = Color3.fromRGB(110, 230, 150),
	Warning = Color3.fromRGB(255, 190, 80),
}
local FONT = Enum.Font.GothamMedium
local FONT_BOLD = Enum.Font.GothamBold

type Props = { [string]: any }

-- Tiny UI helper: create an instance, set properties, add children.
local function new(className: string, props: Props, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(radius: number): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function panel(props: Props): Frame
	local frame = new("Frame", props)
	frame.BackgroundColor3 = COLORS.Panel
	frame.BackgroundTransparency = props.BackgroundTransparency or 0.3
	frame.BorderSizePixel = 0
	corner(8).Parent = frame
	return frame
end

local function label(props: Props): TextLabel
	local base: Props = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = COLORS.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for key, value in props do
		base[key] = value
	end
	return new("TextLabel", base)
end

local gui: ScreenGui
local objectiveText: TextLabel
local toastList: Frame
local subtitleButton: TextButton
local usingLabel: TextLabel
local descLabel: TextLabel
local slotButtons: { TextButton } = {}
local inventoryCopy: { any } = {}
local bars: { [string]: Frame } = {}
local batteryLabel: TextLabel
local edges: { Frame } = {}
local noteFrame: Frame
local noteTitle: TextLabel
local noteBody: TextLabel
local deathFrame: Frame
local endFrame: Frame
local endStats: TextLabel

local dialogueQueue: { any } = {}
local skipCurrentLine = false
local damageFlash = 0

------------------------------------------------------------------------------
-- Building
------------------------------------------------------------------------------

-- Brightness option: brightens only this player's screen (exposure), so
-- anyone who finds the night too dark can fix it without code changes.
local BRIGHTNESS_LEVELS = {
	{ Name = "Normal", Exposure = 0 },
	{ Name = "Bright", Exposure = 0.6 },
	{ Name = "Brightest", Exposure = 1.2 },
}

local function buildBrightnessButton()
	local index = 1
	local button = new("TextButton", {
		Name = "Brightness",
		Position = UDim2.fromOffset(16, 86),
		Size = UDim2.fromOffset(180, 28),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = 13,
		TextColor3 = COLORS.Muted,
		Text = "Brightness: Normal",
		Parent = gui,
	}, { corner(6) })
	button.Activated:Connect(function()
		index = index % #BRIGHTNESS_LEVELS + 1
		local level = BRIGHTNESS_LEVELS[index]
		Lighting.ExposureCompensation = Config.Lighting.ExposureCompensation + level.Exposure
		button.Text = "Brightness: " .. level.Name
	end)
end

-- Outfit option: cycles Jax's outfits (cosmetic; the server applies it).
local function buildOutfitButton()
	local button = new("TextButton", {
		Name = "Outfit",
		Position = UDim2.fromOffset(202, 86),
		Size = UDim2.fromOffset(154, 28),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = 13,
		TextColor3 = COLORS.Muted,
		Text = "Outfit",
		Parent = gui,
	}, { corner(6) })
	local function refresh()
		local id = player:GetAttribute("OutfitId")
		local design = if type(id) == "string" then CharacterDesigns.Designs[id] else nil
		button.Text = "Outfit: " .. (if design then design.Title else "Default Outfit")
	end
	player:GetAttributeChangedSignal("OutfitId"):Connect(refresh)
	refresh()
	button.Activated:Connect(function()
		Remotes.ChangeOutfit:FireServer()
	end)
end

local function buildObjective()
	local frame = panel({
		Name = "Objective",
		Position = UDim2.fromOffset(16, 16),
		Size = UDim2.fromOffset(340, 64),
		Parent = gui,
	})
	label({
		Text = "OBJECTIVE",
		TextSize = 12,
		Font = FONT_BOLD,
		TextColor3 = COLORS.Accent,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 14),
		Parent = frame,
	})
	objectiveText = label({
		Text = "",
		TextSize = 16,
		Position = UDim2.fromOffset(12, 24),
		Size = UDim2.new(1, -24, 1, -30),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame,
	})
end

local function buildToasts()
	toastList = new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(420, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function makeBar(parent: Instance, name: string, color: Color3, y: number, height: number)
	local back = new("Frame", {
		Name = name,
		Position = UDim2.fromOffset(12, y),
		Size = UDim2.new(1, -24, 0, height),
		BackgroundColor3 = Color3.fromRGB(40, 40, 44),
		BorderSizePixel = 0,
		Parent = parent,
	}, { corner(4) })
	local fill = new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = back,
	}, { corner(4) })
	bars[name] = fill
end

local function buildBars()
	local frame = panel({
		Name = "Vitals",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(240, 96),
		Parent = gui,
	})
	label({
		Text = "HEALTH",
		TextSize = 11,
		Font = FONT_BOLD,
		TextColor3 = COLORS.Muted,
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 12),
		Parent = frame,
	})
	makeBar(frame, "Health", COLORS.Health, 20, 10)
	batteryLabel = label({
		Text = "FLASHLIGHT (F)",
		TextSize = 11,
		Font = FONT_BOLD,
		TextColor3 = COLORS.Muted,
		Position = UDim2.fromOffset(12, 36),
		Size = UDim2.new(1, -24, 0, 12),
		Parent = frame,
	})
	makeBar(frame, "Battery", COLORS.Battery, 50, 10)
	label({
		Text = "STAMINA",
		TextSize = 11,
		Font = FONT_BOLD,
		TextColor3 = COLORS.Muted,
		Position = UDim2.fromOffset(12, 66),
		Size = UDim2.new(1, -24, 0, 12),
		Parent = frame,
	})
	makeBar(frame, "Stamina", COLORS.Stamina, 80, 6)
end

local function refreshInventory()
	for i, button in slotButtons do
		local slot = inventoryCopy[i]
		local nameLabel = button:FindFirstChild("ItemName") :: TextLabel
		local countLabel = button:FindFirstChild("Count") :: TextLabel
		local dropButton = button:FindFirstChild("Drop") :: TextButton
		local swatch = button:FindFirstChild("Swatch") :: Frame
		if slot and Items[slot.Id] then
			local def = Items[slot.Id]
			nameLabel.Text = def.DisplayName
			countLabel.Text = if slot.Count > 1 then "x" .. slot.Count else ""
			dropButton.Visible = not def.KeyItem
			swatch.Visible = true
			swatch.BackgroundColor3 = def.Color
		else
			nameLabel.Text = ""
			countLabel.Text = ""
			dropButton.Visible = false
			swatch.Visible = false
		end
	end
end

local function buildInventory()
	local bar = new("Frame", {
		Name = "Inventory",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(Config.Inventory.SlotCount * 78, 72),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i = 1, Config.Inventory.SlotCount do
		local button = new("TextButton", {
			Name = "Slot" .. i,
			LayoutOrder = i,
			Size = UDim2.fromOffset(72, 72),
			BackgroundColor3 = COLORS.Panel,
			BackgroundTransparency = 0.3,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = true,
			Parent = bar,
		}, { corner(8) })
		label({
			Name = "Key",
			Text = tostring(i),
			TextSize = 12,
			Font = FONT_BOLD,
			TextColor3 = COLORS.Muted,
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.fromOffset(14, 14),
			Parent = button,
		})
		new("Frame", {
			Name = "Swatch",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 14),
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = COLORS.Text,
			BorderSizePixel = 0,
			Visible = false,
			Parent = button,
		}, { corner(9) })
		label({
			Name = "ItemName",
			Text = "",
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(2, 36),
			Size = UDim2.new(1, -4, 0, 16),
			Parent = button,
		})
		label({
			Name = "Count",
			Text = "",
			TextSize = 12,
			Font = FONT_BOLD,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.new(0, 0, 1, -18),
			Size = UDim2.new(1, -6, 0, 14),
			Parent = button,
		})
		local drop = new("TextButton", {
			Name = "Drop",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -3, 0, 3),
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = Color3.fromRGB(70, 40, 40),
			Text = "X",
			Font = FONT_BOLD,
			TextSize = 11,
			TextColor3 = COLORS.Text,
			Visible = false,
			Parent = button,
		}, { corner(9) })
		button.Activated:Connect(function()
			Remotes.UseItem:FireServer(i)
		end)
		drop.Activated:Connect(function()
			Remotes.DropItem:FireServer(i)
		end)
		button.MouseEnter:Connect(function()
			local slot = inventoryCopy[i]
			descLabel.Text = if slot and Items[slot.Id] then Items[slot.Id].Description else ""
		end)
		button.MouseLeave:Connect(function()
			descLabel.Text = ""
		end)
		slotButtons[i] = button
	end
	descLabel = label({
		Name = "Description",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -92),
		Size = UDim2.fromOffset(360, 18),
		TextSize = 13,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		Parent = gui,
	})
	usingLabel = label({
		Name = "Using",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -112),
		Size = UDim2.fromOffset(360, 20),
		TextSize = 15,
		Font = FONT_BOLD,
		TextColor3 = COLORS.Good,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		Parent = gui,
	})
end

local function buildSubtitles()
	subtitleButton = new("TextButton", {
		Name = "Subtitles",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -140),
		Size = UDim2.fromScale(0.6, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = FONT,
		TextSize = 18,
		TextColor3 = COLORS.Text,
		TextWrapped = true,
		RichText = true,
		Text = "",
		Visible = false,
		Parent = gui,
	}, {
		corner(8),
		new("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 14),
		}),
		new("UISizeConstraint", { MaxSize = Vector2.new(720, math.huge) }),
	})
	-- Click/tap the subtitle (or press Enter) to skip the current line.
	subtitleButton.Activated:Connect(function()
		skipCurrentLine = true
	end)
end

local function makeEdge(name: string, anchor: Vector2, position: UDim2, size: UDim2, rotation: number)
	local edge = new("Frame", {
		Name = name,
		AnchorPoint = anchor,
		Position = position,
		Size = size,
		BackgroundColor3 = COLORS.Health,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Parent = gui,
	}, {
		-- Solid at the screen edge, fading to nothing toward the middle.
		new("UIGradient", { Rotation = rotation, Transparency = NumberSequence.new(0, 1) }),
	})
	edge.Visible = false
	table.insert(edges, edge)
end

local function buildEdges()
	makeEdge("EdgeTop", Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.22), 90)
	makeEdge("EdgeBottom", Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.22), -90)
	makeEdge("EdgeLeft", Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.18, 1), 0)
	makeEdge("EdgeRight", Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.18, 1), 180)
end

local function buildNoteReader()
	noteFrame = panel({
		Name = "NoteReader",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.75),
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	noteFrame.BackgroundColor3 = Color3.fromRGB(34, 30, 24)
	new("UISizeConstraint", { MaxSize = Vector2.new(560, 460), Parent = noteFrame })
	noteTitle = label({
		Text = "",
		TextSize = 20,
		Font = FONT_BOLD,
		TextColor3 = Color3.fromRGB(240, 220, 170),
		Position = UDim2.fromOffset(20, 16),
		Size = UDim2.new(1, -40, 0, 26),
		ZIndex = 11,
		Parent = noteFrame,
	})
	local scroll = new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 52),
		Size = UDim2.new(1, -40, 1, -110),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 11,
		Parent = noteFrame,
	})
	noteBody = label({
		Text = "",
		TextSize = 17,
		Font = Enum.Font.Merriweather,
		TextColor3 = Color3.fromRGB(230, 220, 200),
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 11,
		Parent = scroll,
	})
	local close = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(160, 38),
		BackgroundColor3 = Color3.fromRGB(70, 60, 48),
		Font = FONT_BOLD,
		TextSize = 16,
		TextColor3 = COLORS.Text,
		Text = "Close (Enter)",
		ZIndex = 11,
		Parent = noteFrame,
	}, { corner(6) })
	close.Activated:Connect(function()
		noteFrame.Visible = false
		ClientState.ModalOpen = false
	end)
end

local function buildDeathScreen()
	deathFrame = new("Frame", {
		Name = "Death",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	label({
		Text = "YOU DIDN'T MAKE IT",
		TextSize = 34,
		Font = FONT_BOLD,
		TextColor3 = COLORS.Health,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(600, 44),
		ZIndex = 21,
		Parent = deathFrame,
	})
	label({
		Text = "Returning to your last checkpoint...",
		TextSize = 18,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(600, 24),
		ZIndex = 21,
		Parent = deathFrame,
	})
end

local function buildEndScreen()
	endFrame = new("Frame", {
		Name = "EndScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(6, 6, 10),
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	label({
		Text = "CHAPTER 1: THE FORGOTTEN EXPEDITION",
		TextSize = 16,
		Font = FONT_BOLD,
		TextColor3 = COLORS.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.new(0.9, 0, 0, 22),
		ZIndex = 31,
		Parent = endFrame,
	})
	label({
		Text = "DEMO COMPLETE",
		TextSize = 42,
		Font = FONT_BOLD,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 28),
		Size = UDim2.new(0.9, 0, 0, 50),
		ZIndex = 31,
		Parent = endFrame,
	})
	endStats = label({
		Text = "",
		TextSize = 18,
		TextColor3 = COLORS.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 100),
		Size = UDim2.new(0.9, 0, 0, 140),
		ZIndex = 31,
		Parent = endFrame,
	})
	label({
		Text = "Riftfall: The Last Ascent continues in Chapter 2 - Blackstone Research Facility.",
		TextSize = 14,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 240),
		Size = UDim2.new(0.9, 0, 0, 40),
		ZIndex = 31,
		Parent = endFrame,
	})
	local again = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 290),
		Size = UDim2.fromOffset(200, 46),
		BackgroundColor3 = COLORS.Accent,
		Font = FONT_BOLD,
		TextSize = 18,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "Play Again",
		ZIndex = 31,
		Parent = endFrame,
	}, { corner(8) })
	again.Activated:Connect(function()
		Remotes.RequestReplay:FireServer()
	end)
end

local function buildControlsHint()
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return -- Touch players get on-screen buttons instead.
	end
	label({
		Name = "Controls",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(260, 100),
		TextSize = 13,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		Text = "WASD  move\nShift  sprint (loud)\nC  crouch (quiet)\nF  flashlight\nE  interact     1-4  use item",
		Parent = gui,
	})
end

------------------------------------------------------------------------------
-- Behaviour
------------------------------------------------------------------------------

local TOAST_COLORS: { [string]: Color3 } = {
	info = COLORS.Text,
	good = COLORS.Good,
	warning = COLORS.Warning,
	objective = COLORS.Accent,
	checkpoint = COLORS.Good,
}

local function showToast(text: string, kind: string)
	local toast = label({
		Text = text,
		TextSize = 16,
		Font = FONT_BOLD,
		TextColor3 = TOAST_COLORS[kind] or COLORS.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.3,
		Size = UDim2.fromOffset(400, 32),
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = toastList,
	})
	corner(6).Parent = toast
	task.delay(3, function()
		local tween =
			TweenService:Create(toast, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)
end

local function escapeRichText(text: string): string
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function runDialogue()
	while true do
		local line = table.remove(dialogueQueue, 1)
		if not line then
			subtitleButton.Visible = false
			return
		end
		if type(line) == "table" and type(line.Text) == "string" then
			subtitleButton.Text = string.format(
				'<font color="#be6eff"><b>%s</b></font>   %s',
				escapeRichText(tostring(line.Speaker or "")),
				escapeRichText(line.Text)
			)
			subtitleButton.Visible = true
			skipCurrentLine = false
			local endTime = os.clock() + (tonumber(line.Duration) or 4)
			while os.clock() < endTime and not skipCurrentLine do
				task.wait(0.05)
			end
		end
	end
end

local dialogueRunning = false
local function queueDialogue(lines: any)
	if type(lines) ~= "table" then
		return
	end
	for _, line in lines do
		table.insert(dialogueQueue, line)
	end
	if not dialogueRunning then
		dialogueRunning = true
		task.spawn(function()
			runDialogue()
			dialogueRunning = false
		end)
	end
end

local function showNote(noteId: string)
	local note = (Story.Notes :: any)[noteId]
	if not note then
		return
	end
	noteTitle.Text = note.Title
	noteBody.Text = note.Body
	noteFrame.Visible = true
	ClientState.ModalOpen = true
end

local function formatTime(seconds: number): string
	local s = math.floor(seconds)
	return string.format("%d:%02d", s // 60, s % 60)
end

local function showEnd(stats: any)
	if type(stats) ~= "table" then
		return
	end
	endStats.Text = string.format(
		"Time: %s\nDeaths: %d\nNotes found: %d / %d\nRift Shard recovered: %s",
		formatTime(tonumber(stats.Time) or 0),
		tonumber(stats.Deaths) or 0,
		tonumber(stats.NotesRead) or 0,
		tonumber(stats.NotesTotal) or 0,
		if stats.FoundShard then "Yes" else "No (it's in the temple...)"
	)
	endFrame.Visible = true
	ClientState.ModalOpen = true
end

local function bindCharacter(character: Model)
	deathFrame.Visible = false
	deathFrame.BackgroundTransparency = 1
	endFrame.Visible = false
	ClientState.ModalOpen = noteFrame.Visible
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local lastHealth = humanoid.Health
	humanoid.HealthChanged:Connect(function(health)
		if health < lastHealth - 0.5 then
			damageFlash = 1
		end
		lastHealth = health
	end)
	humanoid.Died:Connect(function()
		deathFrame.Visible = true
		TweenService:Create(deathFrame, TweenInfo.new(1.2), { BackgroundTransparency = 0.2 }):Play()
	end)
end

function HUDController.Init()
	gui = new("ScreenGui", {
		Name = "RiftfallHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildEdges()
	buildObjective()
	buildBrightnessButton()
	buildOutfitButton()
	buildToasts()
	buildBars()
	buildInventory()
	buildSubtitles()
	buildControlsHint()
	buildNoteReader()
	buildDeathScreen()
	buildEndScreen()
	refreshInventory()

	-- Objective (stored on ReplicatedStorage so late joiners see it too).
	local function updateObjective()
		local text = ReplicatedStorage:GetAttribute("Objective")
		objectiveText.Text = if type(text) == "string" then text else ""
	end
	ReplicatedStorage:GetAttributeChangedSignal("Objective"):Connect(updateObjective)
	updateObjective()

	-- Item-use progress text.
	player:GetAttributeChangedSignal("UsingItem"):Connect(function()
		local using = player:GetAttribute("UsingItem")
		usingLabel.Text = if type(using) == "string" then "Using " .. using .. "..." else ""
	end)

	Remotes.Toast.OnClientEvent:Connect(function(text, kind)
		if type(text) == "string" then
			showToast(text, if type(kind) == "string" then kind else "info")
		end
	end)
	Remotes.Dialogue.OnClientEvent:Connect(queueDialogue)
	Remotes.ShowNote.OnClientEvent:Connect(function(noteId)
		if type(noteId) == "string" then
			showNote(noteId)
		end
	end)
	Remotes.InventoryChanged.OnClientEvent:Connect(function(slots)
		if type(slots) == "table" then
			inventoryCopy = {}
			for i = 1, Config.Inventory.SlotCount do
				local slot = slots[i]
				inventoryCopy[i] = if type(slot) == "table" then slot else nil
			end
			refreshInventory()
		end
	end)
	Remotes.RunComplete.OnClientEvent:Connect(showEnd)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local slotKeys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
		local index = table.find(slotKeys, input.KeyCode)
		if index and index <= Config.Inventory.SlotCount then
			Remotes.UseItem:FireServer(index)
		elseif input.KeyCode == Enum.KeyCode.Return then
			if noteFrame.Visible then
				noteFrame.Visible = false
				ClientState.ModalOpen = endFrame.Visible
			else
				skipCurrentLine = true
			end
		end
	end)

	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end

	-- Per-frame bar and edge-effect updates (cheap property sets only).
	local pulse = 0
	RunService.RenderStepped:Connect(function(dt)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local healthFraction = 0
		if humanoid and humanoid.MaxHealth > 0 then
			healthFraction = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		end
		bars.Health.Size = UDim2.fromScale(healthFraction, 1)

		local battery = player:GetAttribute("Battery")
		local batteryFraction = if type(battery) == "number" then battery / Config.Flashlight.MaxBattery else 0
		bars.Battery.Size = UDim2.fromScale(math.clamp(batteryFraction, 0, 1), 1)
		local lightOn = player:GetAttribute("FlashlightOn") == true
		bars.Battery.BackgroundColor3 = if batteryFraction < 0.2 then COLORS.Warning else COLORS.Battery
		batteryLabel.Text = if lightOn then "FLASHLIGHT (F) - ON" else "FLASHLIGHT (F) - OFF"

		bars.Stamina.Size = UDim2.fromScale(math.clamp(ClientState.Stamina / Config.Player.MaxStamina, 0, 1), 1)

		-- Edge glow: damage flash (red) beats danger pulse (dark violet).
		damageFlash = math.max(0, damageFlash - dt * 1.6)
		pulse += dt * (2 + ClientState.Danger * 4)
		local danger = ClientState.Danger * (0.6 + 0.4 * math.sin(pulse))
		local lowHealth = if healthFraction > 0 and healthFraction < 0.35 then 0.35 else 0
		local strength = math.max(damageFlash, danger * 0.7, lowHealth)
		local color = if damageFlash > danger * 0.7 or lowHealth > danger * 0.7
			then COLORS.Health
			else Color3.fromRGB(70, 20, 90)
		for _, edge in edges do
			edge.Visible = strength > 0.02
			edge.BackgroundColor3 = color
			edge.BackgroundTransparency = 1 - strength * 0.8
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict
-- MovementController: sprint (hold Shift), crouch (press C), and stamina.
-- On touch screens, on-screen buttons are added for both.
--
-- Movement speed is applied on the client because Roblox characters are
-- physically simulated by their own player. The server listens for noise
-- (how fast you move) when deciding if the Rift Stalker hears you.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local ClientState = require(script.Parent.Parent.ClientState)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local P = Config.Player

local MovementController = {}

local sprintHeld = false
local exhausted = false
local humanoid: Humanoid? = nil

local function setCrouch(on: boolean)
	if ClientState.Crouching == on then
		return
	end
	ClientState.Crouching = on
	Remotes.SetCrouch:FireServer(on)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(0.25), {
			CameraOffset = if on then Vector3.new(0, -1.6, 0) else Vector3.zero,
		}):Play()
	end
end

local function onSprint(_: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	if inputState == Enum.UserInputState.Begin then
		sprintHeld = true
		setCrouch(false)
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		sprintHeld = false
	end
	return Enum.ContextActionResult.Sink
end

local function onCrouch(_: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	if inputState == Enum.UserInputState.Begin then
		setCrouch(not ClientState.Crouching)
	end
	return Enum.ContextActionResult.Sink
end

local function onCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	ClientState.Stamina = P.MaxStamina
	ClientState.Crouching = false
	exhausted = false
	Remotes.SetCrouch:FireServer(false)
end

function MovementController.Init()
	ContextActionService:BindAction("RiftfallSprint", onSprint, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("RiftfallSprint", "Sprint")
	ContextActionService:SetPosition("RiftfallSprint", UDim2.new(1, -170, 1, -150))
	ContextActionService:BindAction("RiftfallCrouch", onCrouch, true, Enum.KeyCode.C, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("RiftfallCrouch", "Crouch")
	ContextActionService:SetPosition("RiftfallCrouch", UDim2.new(1, -230, 1, -90))

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	RunService.Heartbeat:Connect(function(dt)
		local hum = humanoid
		if not hum or hum.Health <= 0 then
			return
		end
		local moving = hum.MoveDirection.Magnitude > 0.1
		local sprinting = sprintHeld and moving and not exhausted and not ClientState.Crouching

		if sprinting then
			ClientState.Stamina = math.max(0, ClientState.Stamina - P.StaminaDrainPerSecond * dt)
			if ClientState.Stamina <= 0 then
				exhausted = true
			end
		else
			ClientState.Stamina = math.min(P.MaxStamina, ClientState.Stamina + P.StaminaRegenPerSecond * dt)
			if exhausted and ClientState.Stamina >= P.StaminaRecoverThreshold then
				exhausted = false
			end
		end

		if ClientState.Crouching then
			hum.WalkSpeed = P.CrouchSpeed
		elseif sprinting then
			hum.WalkSpeed = P.SprintSpeed
		else
			hum.WalkSpeed = P.WalkSpeed
		end
	end)
end

return MovementController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Main (client): starts every client controller. Runs once per player, from
-- StarterPlayerScripts, and survives respawns.

local Controllers = script.Parent.Controllers

local HUDController = require(Controllers.HUDController)
local MovementController = require(Controllers.MovementController)
local FlashlightController = require(Controllers.FlashlightController)
local AtmosphereController = require(Controllers.AtmosphereController)

HUDController.Init()
MovementController.Init()
FlashlightController.Init()
AtmosphereController.Init()

print("[Riftfall] Client ready.")
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="56">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>