		Parent = endFrame,
	})
	endStats = label({
		Text = "",
		TextSize = 18,
		TextColor3 = COLORS.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 100),
		Size = UDim2.new(0.9, 0, 0, 140),
		ZIndex = 31,
		Parent = endFrame,
	})
	label({
