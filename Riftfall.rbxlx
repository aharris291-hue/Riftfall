          <string name="Name">CharacterDesigns</string>
          <string name="Source"><![CDATA[--!strict
-- CharacterDesigns: the look of every character, taken from the Riftfall
-- character concept sheet. Pure data (colours, hair style, which gear pieces
-- to attach); the server's Outfitter turns it into parts on an R15 body.
--
-- To restyle a character, change colours or the Gear list here. Gear names
-- must match a builder in src/server/Util/Outfitter.luau.

export type Design = {
	Id: string,
	DisplayName: string,
	Title: string,
	Skin: Color3,
	Hair: Color3,
	HairStyle: "Messy" | "Bun" | "Short" | "Bob" | "None",
	Eyes: Color3,
	-- Body part colours.
	Jacket: Color3,
	Sleeves: Color3,
	Gloves: Color3,
	Trousers: Color3,
	Boots: Color3,
	-- Detail colours used by gear pieces.
	Leather: Color3,
	Accent: Color3, -- Glowing tech accent (wrist device, visor, core).
	Secondary: Color3,
	Gear: { string },
	-- Optional body proportions (1 = default).
	Width: number?,
	Height: number?,
	Hologram: boolean?, -- Serra is projected, not physically present.
}

local CYAN = Color3.fromRGB(70, 220, 255)

local Designs: { [string]: Design } = {}

-- Protagonist: Jax Mercer. An ordinary person who survives a catastrophe;
-- determined, resourceful, haunted. Dark hooded jacket, brown leather
-- harness and belts, cargo trousers with knee pads, cyan wrist device.
Designs.Jax = {
	Id = "Jax",
	DisplayName = "Jax Mercer",
	Title = "Default Outfit",
	Skin = Color3.fromRGB(226, 182, 150),
	Hair = Color3.fromRGB(74, 50, 34),
	HairStyle = "Messy",
	Eyes = Color3.fromRGB(70, 52, 40),
	Jacket = Color3.fromRGB(46, 48, 54),
	Sleeves = Color3.fromRGB(40, 42, 48),
	Gloves = Color3.fromRGB(30, 30, 32),
	Trousers = Color3.fromRGB(52, 52, 56),
	Boots = Color3.fromRGB(78, 54, 36),
	Leather = Color3.fromRGB(96, 64, 40),
	Accent = CYAN,
	Secondary = Color3.fromRGB(70, 72, 78),
	Gear = { "HoodDown", "Collar", "Harness", "Belt", "ThighStraps", "KneePads", "Backpack", "WristDevice" },
}

-- Jax's alternate outfits (concept sheet: "Alternate Outfits" and
-- "Character Variants"). Each player picks one with the Outfit button.
Designs.JaxStealth = table.clone(Designs.Jax)
Designs.JaxStealth.Id = "JaxStealth"
Designs.JaxStealth.Title = "Stealth"
Designs.JaxStealth.Jacket = Color3.fromRGB(28, 28, 36)
Designs.JaxStealth.Sleeves = Color3.fromRGB(24, 24, 30)
Designs.JaxStealth.Trousers = Color3.fromRGB(30, 30, 38)
Designs.JaxStealth.Boots = Color3.fromRGB(26, 26, 30)
Designs.JaxStealth.Leather = Color3.fromRGB(44, 44, 54)
Designs.JaxStealth.Accent = Color3.fromRGB(150, 110, 255)
Designs.JaxStealth.Gear = { "HoodUp", "Mask", "Harness", "Belt", "ThighStraps", "KneePads", "WristDevice" }

Designs.JaxSurvival = table.clone(Designs.Jax)
Designs.JaxSurvival.Id = "JaxSurvival"
Designs.JaxSurvival.Title = "Survival"
Designs.JaxSurvival.Jacket = Color3.fromRGB(196, 150, 48)
Designs.JaxSurvival.Sleeves = Color3.fromRGB(184, 140, 44)
Designs.JaxSurvival.Trousers = Color3.fromRGB(58, 56, 52)
Designs.JaxSurvival.Accent = Color3.fromRGB(255, 170, 60)
Designs.JaxSurvival.Gear = { "HoodDown", "Collar", "Harness", "Belt", "KneePads", "Backpack", "WristDevice" }

Designs.JaxWanderer = table.clone(Designs.Jax)
Designs.JaxWanderer.Id = "JaxWanderer"
Designs.JaxWanderer.Title = "Wanderer"
Designs.JaxWanderer.Jacket = Color3.fromRGB(110, 82, 58)
Designs.JaxWanderer.Sleeves = Color3.fromRGB(98, 72, 50)
Designs.JaxWanderer.Trousers = Color3.fromRGB(70, 60, 50)
Designs.JaxWanderer.Leather = Color3.fromRGB(70, 48, 32)
Designs.JaxWanderer.Gear = { "HoodUp", "Collar", "Harness", "Belt", "ThighStraps", "Backpack", "WristDevice" }

Designs.JaxHeavy = table.clone(Designs.Jax)
Designs.JaxHeavy.Id = "JaxHeavy"
Designs.JaxHeavy.Title = "Heavy Armor"
Designs.JaxHeavy.Jacket = Color3.fromRGB(70, 72, 76)
Designs.JaxHeavy.Sleeves = Color3.fromRGB(58, 60, 64)
Designs.JaxHeavy.Secondary = Color3.fromRGB(96, 98, 104)
Designs.JaxHeavy.Gear = { "Collar", "ChestPlate", "ShoulderPads", "Belt", "KneePads", "Backpack", "WristDevice" }

-- Serra, the AI companion: projected as a cyan hologram. White and grey
-- armour with glowing lines over a dark suit, blue bob.
Designs.Serra = {
	Id = "Serra",
	DisplayName = "Serra",
	Title = "The AI Companion",
	Skin = Color3.fromRGB(200, 226, 240),
	Hair = Color3.fromRGB(40, 110, 220),
	HairStyle = "Bob",
	Eyes = CYAN,
	Jacket = Color3.fromRGB(226, 232, 238),
	Sleeves = Color3.fromRGB(30, 34, 44),
	Gloves = Color3.fromRGB(220, 226, 232),
	Trousers = Color3.fromRGB(210, 216, 224),
	Boots = Color3.fromRGB(226, 232, 238),
	Leather = Color3.fromRGB(30, 34, 44),
	Accent = CYAN,
	Secondary = Color3.fromRGB(180, 188, 200),
	Gear = { "ChestPlate", "ShoulderPads", "GlowLines", "Belt" },
	Width = 0.92,
	Hologram = true,
}

-- Kade, the veteran: a former elite soldier. Bearded, heavy brown tactical
-- armour, ammo pouches. Practical, loyal, carries a personal vendetta.
Designs.Kade = {
	Id = "Kade",
	DisplayName = "Kade",
	Title = "The Veteran",
	Skin = Color3.fromRGB(190, 140, 104),
	Hair = Color3.fromRGB(46, 34, 26),
	HairStyle = "Short",
	Eyes = Color3.fromRGB(50, 40, 32),
	Jacket = Color3.fromRGB(86, 70, 52),
	Sleeves = Color3.fromRGB(62, 58, 50),
	Gloves = Color3.fromRGB(36, 34, 30),
	Trousers = Color3.fromRGB(70, 66, 56),
	Boots = Color3.fromRGB(46, 36, 28),
	Leather = Color3.fromRGB(80, 58, 38),
	Accent = Color3.fromRGB(255, 190, 90),
	Secondary = Color3.fromRGB(104, 96, 78),
	Gear = { "Beard", "ChestPlate", "ShoulderPads", "AmmoPouches", "Belt", "ThighStraps", "KneePads", "Backpack" },
	Width = 1.12,
	Height = 1.04,
}

-- Lira, the scientist: brilliant researcher. Dark hair in a bun, glasses,
-- long white lab coat over a lavender shirt. Curious, cautious, brave.
Designs.Lira = {
	Id = "Lira",
	DisplayName = "Lira",
	Title = "The Scientist",
	Skin = Color3.fromRGB(236, 200, 172),
	Hair = Color3.fromRGB(28, 24, 30),
	HairStyle = "Bun",
	Eyes = Color3.fromRGB(60, 46, 40),
	Jacket = Color3.fromRGB(176, 150, 200),
	Sleeves = Color3.fromRGB(232, 232, 236),
	Gloves = Color3.fromRGB(70, 74, 84),
	Trousers = Color3.fromRGB(46, 48, 58),
	Boots = Color3.fromRGB(36, 36, 40),
	Leather = Color3.fromRGB(60, 60, 70),
	Accent = Color3.fromRGB(150, 210, 255),
	Secondary = Color3.fromRGB(236, 236, 240),
	Gear = { "Glasses", "LabCoat", "Belt", "Tablet" },
	Width = 0.92,
	Height = 0.97,
}

-- Corrupted Soldier: human, enhanced with alien tech. Dark grey heavy armour,
-- helmet with a red visor, glowing red chest core.
Designs.CorruptedSoldier = {
	Id = "CorruptedSoldier",
	DisplayName = "Corrupted Soldier",
	Title = "Human Faction",
	Skin = Color3.fromRGB(110, 104, 110),
	Hair = Color3.fromRGB(30, 30, 30),
	HairStyle = "None",
	Eyes = Color3.fromRGB(255, 40, 30),
	Jacket = Color3.fromRGB(52, 54, 58),
	Sleeves = Color3.fromRGB(44, 46, 50),
	Gloves = Color3.fromRGB(34, 34, 36),
	Trousers = Color3.fromRGB(46, 48, 52),
	Boots = Color3.fromRGB(30, 30, 32),
	Leather = Color3.fromRGB(70, 46, 40),
	Accent = Color3.fromRGB(255, 50, 40),
	Secondary = Color3.fromRGB(76, 78, 84),
	Gear = { "Helmet", "ChestPlate", "ChestCore", "ShoulderPads", "Belt", "AmmoPouches", "KneePads", "Crystals" },
	Width = 1.15,
	Height = 1.06,
}

return {
	Designs = Designs,
	-- The order the Outfit button cycles through.
	PlayerOutfits = { "Jax", "JaxStealth", "JaxSurvival", "JaxWanderer", "JaxHeavy" },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Config: every tunable number for the demo lives here, so balance changes
-- never require digging through gameplay code.

local Config = {}

Config.Player = {
	WalkSpeed = 12,
	SprintSpeed = 20,
	CrouchSpeed = 6,
	MaxStamina = 100,
	StaminaDrainPerSecond = 22,
	StaminaRegenPerSecond = 14,
	-- Stamina must refill to this before sprinting is allowed again after running dry.
	StaminaRecoverThreshold = 30,
}

Config.Inventory = {
	SlotCount = 4,
	-- Seconds a player must wait between item uses (stops spam/exploit requests).
	UseCooldown = 1.0,
}

Config.Flashlight = {
	MaxBattery = 100,
	-- Battery drained per second while the light is on.
	DrainPerSecond = 1.2,
	StartingBattery = 60,
	Range = 60,
	Brightness = 6,
	Angle = 45,
	-- The visible beam ("light path") in front of the player.
	BeamLength = 32,
	BeamStartWidth = 0.6,
	BeamEndWidth = 16,
	BeamOpacity = 0.22, -- 0 = invisible beam, 1 = solid.
}

Config.Stalker = {
	MaxHealth = 1000, -- The demo enemy cannot be killed; it is avoided, not fought.
	PatrolSpeed = 7,
	InvestigateSpeed = 11,
	ChaseSpeed = 17,
	HuntSpeed = 16, -- Speed during the scripted escape sequence.
	SightRange = 55,
	SightRangeFlashlightOn = 80, -- Your light makes you easier to spot.
	SightHalfAngle = 60, -- Degrees either side of where it is facing.
	HearingSprint = 45,
	HearingWalk = 16,
	HearingCrouch = 5,
	HidingRevealDistance = 7, -- Hidden players are only noticed this close.
	AttackRange = 5.5,
	AttackWindup = 0.45, -- Telegraph before the swing lands (fair horror).
	AttackDamage = 25,
	AttackCooldown = 1.6,
	LoseSightTime = 4, -- Seconds without seeing you before it starts searching.
	SearchTime = 7,
	InvestigateTime = 5,
	TickInterval = 0.2, -- AI update rate in seconds.
	RepathInterval = 0.6,
}

Config.Escape = {
	DebrisDamage = 30,
	DebrisWarningTime = 1.3, -- Seconds the red warning circle shows before a rock lands.
	DebrisInterval = 0.7,
	HuntDelay = 4, -- Seconds after the escape starts before the Stalker is released.
}

-- Night lighting. Raise Brightness / Ambient / OutdoorAmbient to make the
-- world brighter, lower them for a darker, scarier night. FogDensity is how
-- thick the mist is (0 = none, 1 = very thick).
Config.Lighting = {
	ClockTime = 0.5,
	Brightness = 1.6,
	ExposureCompensation = 0.35,
	Ambient = Color3.fromRGB(52, 56, 66),
	OutdoorAmbient = Color3.fromRGB(96, 104, 118),
	FogDensity = 0.3,
	FogHaze = 1,
}

Config.World = {
	KillHeight = -40, -- Falling below this Y position is fatal.
}

-- Sound asset IDs. These are EMPTY on purpose: no audio has been chosen yet,
-- and made-up IDs would not work. To add a sound, find one you are allowed to
-- use in the Creator Store (Toolbox > Audio), copy its number, and paste it
-- here as "rbxassetid://123456789". Empty entries are simply skipped.
Config.Sounds = {
	Rain = "",
	Thunder = "",
	Heartbeat = "",
	Rumble = "",
	Pickup = "",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">FlashlightVisuals</string>
          <string name="Source"><![CDATA[--!strict
-- FlashlightVisuals: builds the flashlight's light and its visible beam (the
-- "light path") on a part. The light shines out of the part's Front face,
-- and the beam runs straight ahead of it, widening like a real torch beam.
--
-- The server puts one on each character's head so everyone sees each other's
-- lights. The local player's own copy is a separate client-side part aimed
-- exactly where the camera looks (see client FlashlightController).

local Config = require(script.Parent.Config)

local FlashlightVisuals = {}

export type Rig = {
	Light: SpotLight,
	Beam: Beam,
	Glow: PointLight,
}

local LIGHT_COLOR = Color3.fromRGB(255, 240, 210)

function FlashlightVisuals.Create(part: BasePart, forwardOffset: number): Rig
	local F = Config.Flashlight

	local light = Instance.new("SpotLight")
	light.Name = "Flashlight"
	light.Face = Enum.NormalId.Front
	light.Range = F.Range
	light.Brightness = F.Brightness
	light.Angle = F.Angle
	light.Color = LIGHT_COLOR
	light.Shadows = true
	light.Enabled = false
	light.Parent = part

	-- A soft glow at the lens so the torch itself reads as "on".
	local glow = Instance.new("PointLight")
	glow.Name = "FlashlightGlow"
	glow.Range = 6
	glow.Brightness = 1
	glow.Color = LIGHT_COLOR
	glow.Enabled = false
	glow.Parent = part

	local startAttachment = Instance.new("Attachment")
	startAttachment.Name = "BeamStart"
	startAttachment.Position = Vector3.new(0, 0, -forwardOffset)
	startAttachment.Parent = part
	local endAttachment = Instance.new("Attachment")
	endAttachment.Name = "BeamEnd"
	endAttachment.Position = Vector3.new(0, 0, -(forwardOffset + F.BeamLength))
	endAttachment.Parent = part

	local beam = Instance.new("Beam")
	beam.Name = "FlashlightBeam"
	beam.Attachment0 = startAttachment
	beam.Attachment1 = endAttachment
	beam.Width0 = F.BeamStartWidth
	beam.Width1 = F.BeamEndWidth
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Segments = 1
	beam.Color = ColorSequence.new(LIGHT_COLOR)
	-- Brightest at the lens, fading out toward the far end.
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1 - F.BeamOpacity),
		NumberSequenceKeypoint.new(0.6, 1 - F.BeamOpacity * 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Enabled = false
	beam.Parent = part

	return { Light = light, Beam = beam, Glow = glow }
end

function FlashlightVisuals.SetEnabled(rig: Rig, on: boolean)
	rig.Light.Enabled = on
	rig.Beam.Enabled = on
	rig.Glow.Enabled = on
end

return FlashlightVisuals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!strict
-- Items: the definition of every item in the demo. The server reads these
-- definitions to decide what an item does; the client only uses them for
-- names, colors, and descriptions in the UI.

export type ItemDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	MaxStack: number,
	Color: Color3,
	-- Key items cannot be dropped, so progress can never be soft-locked.
	KeyItem: boolean,
	-- Seconds the use action takes (the player is told it is in progress).
	UseTime: number,
	HealAmount: number?,
	BatteryAmount: number?,
}

local Items: { [string]: ItemDef } = {
	Bandage = {
		Id = "Bandage",
		DisplayName = "Bandage",
		Description = "Field dressing. Restores 35 health.",
		MaxStack = 3,
		Color = Color3.fromRGB(230, 225, 210),
		KeyItem = false,
		UseTime = 1.5,
		HealAmount = 35,
	},
	Battery = {
		Id = "Battery",
		DisplayName = "Battery",
		Description = "Recharges your flashlight by 50%.",
		MaxStack = 3,
		Color = Color3.fromRGB(120, 200, 255),
		KeyItem = false,
		UseTime = 0.8,
		BatteryAmount = 50,
	},
	RiftShard = {
		Id = "RiftShard",
		DisplayName = "Rift Shard",
		Description = "A warm, humming stone fragment. Evidence for the expedition.",
		MaxStack = 1,
		Color = Color3.fromRGB(190, 110, 255),
		KeyItem = true,
		UseTime = 0,
	},
}

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Story</string>
          <string name="Source"><![CDATA[--!strict
-- Story: all player-facing writing for the Chapter 1 demo in one place:
-- objectives, radio dialogue, and readable notes. Edit text here freely.

export type Line = {
	Speaker: string,
	Text: string,
	Duration: number,
}

local Story = {}

Story.Objectives = {
	Start = "Follow the trail north toward the distress signal",
	Camp = "Search the abandoned expedition camp",
	Ruins = "Cross the ruins and enter the temple. Stay out of sight.",
	Puzzle = "Open the sealed temple door",
	Escape = "The temple is collapsing. GET OUT!",
	Bridge = "Climb the cliff and cross the bridge to the flare",
	Done = "Signal reached. Chapter 1 demo complete.",
}

-- Cast (from the character concept sheet):
--   Jax Mercer  the player. An ordinary survivor of the helicopter crash.
--   Serra       the AI companion who lives in Jax's wrist unit (comms).
--   Kade        the veteran. His brother Daniel was on the Rourke expedition.
--   Lira        the expedition scientist, studying the Vael ruins.
Story.Dialogue = {
	Intro = {
		{
			Speaker = "SERRA (AI)",
			Text = "Jax. Wake up. Your vitals are stable. The helicopter's are not.",
			Duration = 4.5,
		},
		{
			Speaker = "SERRA (AI)",
			Text = "The distress signal is still broadcasting, north of the crash, past the old trail.",
			Duration = 4.5,
		},
		{ Speaker = "SERRA (AI)", Text = "Same frequency the Rourke expedition used. Twelve years ago.", Duration = 4 },
		{
			Speaker = "SERRA (AI)",
			Text = "Press F for your flashlight. Batteries are limited. I did the maths.",
			Duration = 4,
		},
	},
	ClawMarks = {
		{
			Speaker = "SERRA (AI)",
			Text = "Scanning those marks... No animal on record makes cuts like that. I would like to leave now.",
			Duration = 4.5,
		},
	},
	Camp = {
		{
			Speaker = "KADE",
			Text = "Easy! Hands where I can see them... You're from the chopper. Name's Kade.",
			Duration = 4.5,
		},
		{
			Speaker = "KADE",
			Text = "This was Rourke's camp. My brother Daniel came out here with him. Never came back.",
			Duration = 5,
		},
		{
			Speaker = "KADE",
			Text = "Leg's busted, so I'm holding this camp. Grab what you need. Read the journal on the table.",
			Duration = 5,
		},
	},
	Ruins = {
		{
			Speaker = "SERRA (AI)",
			Text = "Movement in the ruins ahead. Large. Bipedal. Its energy signature is... not from here.",
			Duration = 4.5,
		},
		{
			Speaker = "SERRA (AI)",
			Text = "It hunts by sound. Press C to crouch and stay in the tall grass.",
			Duration = 4.5,
		},
	},
	Temple = {
		{ Speaker = "LIRA", Text = "Shh! Over here. Lira, expedition science team. You must be Jax.", Duration = 4.5 },
		{
			Speaker = "LIRA",
			Text = "That door is Vael. Three dials. The mural shows the first and last symbols.",
			Duration = 4.5,
		},
		{
			Speaker = "LIRA",
			Text = "Rourke's journal had the middle one. Did you find it? I'll keep watch.",
			Duration = 4,
		},
	},
	Solved = {
		{
			Speaker = "SERRA (AI)",
			Text = "Door's opening. Jax, energy readings just went off the scale. The mountain is moving.",
			Duration = 4,
		},
		{
			Speaker = "LIRA",
			Text = "It's coming for the door! Run! Kade and I will meet you at the flare!",
			Duration = 4,
		},
	},
	Bridge = {
		{
			Speaker = "SERRA (AI)",
			Text = "Climb. That bridge has a structural rating of 'please hurry'.",
			Duration = 3.5,
		},
	},
	Done = {
		{
			Speaker = "KADE",
			Text = "Got you! Lira, help me pull Jax up. Welcome to the worst expedition on Earth.",
			Duration = 4.5,
		},
		{
			Speaker = "LIRA",
			Text = "That thing wasn't hunting us. It was guarding something. We need to go back down.",
			Duration = 4.5,
		},
		{
			Speaker = "SERRA (AI)",
			Text = "Recording everything. Chapter one, Jax. I don't think it's the last.",
			Duration = 4,
		},
	},
	TalkSerra = {
		{
			Speaker = "SERRA (AI)",
			Text = "I'm the AI in your wrist unit. Think of me as your very honest co-pilot.",
			Duration = 4,
		},
		{
			Speaker = "SERRA (AI)",
			Text = "Head north up the trail. Stay off the open ground if you hear anything big.",
			Duration = 4,
		},
	},
	TalkKade = {
		{
			Speaker = "KADE",
			Text = "Use the bandages when it counts, not before. And never let that thing see you run.",
			Duration = 4.5,
		},
		{
			Speaker = "KADE",
			Text = "If you find anything of Daniel's out there... bring it back. Please.",
			Duration = 4,
		},
	},
	TalkLira = {
		{
			Speaker = "LIRA",
			Text = "The shards hum near the Rift. Rourke thought the Vael sealed something in.",
			Duration = 4.5,
		},
		{
			Speaker = "LIRA",
			Text = "Mural first, journal second. Left to right. Eye... and Sun, I think.",
			Duration = 4,
		},
	},
	TalkKadeEnd = {
		{
			Speaker = "KADE",
			Text = "We hold here until the rescue team spots the flare. You did good, kid.",
			Duration = 4,
		},
	},
	TalkLiraEnd = {
		{
			Speaker = "LIRA",
			Text = "If you found a Rift Shard, keep it safe. It might tell us what's down there.",
			Duration = 4,
		},
	},
}

-- Readable notes found in the world. The camp journal holds the puzzle clue.
Story.Notes = {
	Soldier = {
		Title = "A soldier in the ruins",
		Body = "Heavy military armour. Not Rourke's team, and not ours.\n\nViolet crystal has grown straight through the chest plate. The red visor is still flickering, and the core in its chest is warm to the touch.\n\nIt isn't breathing. You're almost sure it isn't breathing.",
	},
	Scrawl = {
		Title = "Scratched into a crate",
		Body = "IT HUNTS BY SOUND\n\nIt hears you run. It hears you breathe.\nStay low. Stay in the grass.\nIt only sees what moves in the open.\n\nDON'T LET IT SEE YOUR LIGHT",
	},
	Journal = {
		Title = "Dr. Elias Rourke - Field Journal",
		Body = 'Day 19.\nThe Vael built their door to answer only those who knew the old sky.\n\nThe carving above the door is worn, but the verse survives:\n"First the EYE that watches. Last the SUN that sleeps.\nBetween them the MOON is held."\n\nThree dials. Left to right. I am certain of it now.\n\nSomething answers when we work at night. Daniel says it is the wind.\nIt is not the wind.',
	},
	Mural = {
		Title = "Temple mural",
		Body = "A faded carving shows three symbols in a row above a great door.\n\nThe first is an EYE.\nThe middle symbol has crumbled away.\nThe last is a SUN.\n\nBeneath it, figures flee from a crack in the mountain.",
	},
	Recording = {
		Title = "Torn page near the shard",
		Body = "...the shards hum louder near the crack. Twelve of us came. Four are left.\nThe door was never meant to keep us out.\nIt was meant to keep something IN.\n\n- E.R.",
	},
}

return Story
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="22">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="23">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="24">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Main (server): the single entry point for all server code. It builds the
-- world, starts each service in order, and wires services together.
--
-- Where things live:
--   ServerScriptService/Server/Main            this script
--   ServerScriptService/Server/Services/*      one module per game system
--   ServerScriptService/Server/Util/*          shared helpers
--   ReplicatedStorage/Shared/*                 config, items, story text
--   ReplicatedStorage/Remotes/*                client <-> server messages

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Items = require(ReplicatedStorage.Shared.Items)
local Services = script.Parent.Services
local PlayerData = require(script.Parent.Util.PlayerData)
local LevelBuilder = require(Services.LevelBuilder)
local StoryService = require(Services.StoryService)
local CharacterService = require(Services.CharacterService)
local InventoryService = require(Services.InventoryService)
local InteractionService = require(Services.InteractionService)
local FlashlightService = require(Services.FlashlightService)
local CheckpointService = require(Services.CheckpointService)
local PuzzleService = require(Services.PuzzleService)
local StalkerService = require(Services.StalkerService)
local EscapeService = require(Services.EscapeService)
local GameService = require(Services.GameService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

-- 1. World
LevelBuilder.SetupLighting()
LevelBuilder.Build()

-- 2. Wiring between services
InventoryService.SpawnDroppedItem = function(itemId, position)
	local def = Items[itemId]
	if def then
		LevelBuilder.SpawnPickup(itemId, def.DisplayName, position, def.Color)
	end
end
PuzzleService.OnSolved = function()
	EscapeService.Begin()
end
CheckpointService.OnPlayerSpawned(function(player)
	InventoryService.Sync(player)
end)

-- 3. Services
PlayerData.Init()
StoryService.Init()
CharacterService.Init()
InventoryService.Init()
InteractionService.Init()
FlashlightService.Init()
CheckpointService.Init()
PuzzleService.Init()
StalkerService.Init()
EscapeService.Init()
GameService.Init()

StalkerService.SpawnPatrol()

-- Crouch state is reported by the client and only used for stealth checks.
Remotes.SetCrouch.OnServerEvent:Connect(function(player, crouching)
	if type(crouching) == "boolean" then
		player:SetAttribute("Crouching", crouching)
	end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterRemoving:Connect(function()
		player:SetAttribute("Crouching", false)
	end)
end)

print("[Riftfall] Server ready.")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--!strict
-- CharacterService: every character in the game, styled from the Riftfall
-- character concept sheet (see Shared/CharacterDesigns and Util/Outfitter).
--
--  * Players are Jax Mercer. Each player wears one of Jax's outfits
--    (Default, Stealth, Survival, Wanderer, Heavy Armor) and can switch with
--    the Outfit button. The choice is cosmetic only; the server validates it.
--    (StarterPlayer.LoadCharacterAppearance is off, so Roblox avatars never
--    load.)
--  * Story characters (Serra, Kade, Lira, and a dormant Corrupted Soldier)
--    are spawned on "CharacterSpot" markers placed by LevelBuilder. A spot's
--    Phase decides when it is used: Kade and Lira move from the camp and
--    temple to the rescue flare once the escape begins.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local CharacterDesigns = require(ReplicatedStorage.Shared.CharacterDesigns)
local Outfitter = require(script.Parent.Parent.Util.Outfitter)
local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local StoryService = require(script.Parent.StoryService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Designs = CharacterDesigns.Designs

local CharacterService = {}

-- Talk prompt dialogue per character and phase.
local TALK_DIALOGUE: { [string]: { [string]: string } } = {
	Serra = { Explore = "TalkSerra", Escape = "TalkSerra" },
	Kade = { Explore = "TalkKade", Escape = "TalkKadeEnd" },
	Lira = { Explore = "TalkLira", Escape = "TalkLiraEnd" },
}

------------------------------------------------------------------------------
-- Players
------------------------------------------------------------------------------

local joinCount = 0

local function outfitFor(player: Player): string
	local chosen = player:GetAttribute("OutfitId")
	if type(chosen) == "string" and table.find(CharacterDesigns.PlayerOutfits, chosen) then
		return chosen
	end
	-- First player is classic Jax; co-op partners get different outfits.
	local outfits = CharacterDesigns.PlayerOutfits
	local pick = outfits[(joinCount % #outfits) + 1]
	joinCount += 1
	player:SetAttribute("OutfitId", pick)
	return pick
end

local function dressPlayer(player: Player, character: Model)
	-- Wait briefly for the body parts to exist.
	for _, name in { "Head", "UpperTorso", "LowerTorso" } do
		if not character:FindFirstChild(name) then
			character:WaitForChild(name, 5)
		end
	end
	if character.Parent == nil then
		return
	end
	local design = Designs[outfitFor(player)]
	if Outfitter.Apply(character, design) then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayName = player.DisplayName
		end
	end
end

local function onChangeOutfit(player: Player)
	if not PlayerData.RateLimit(player, "Outfit", 1) then
		return
	end
	local outfits = CharacterDesigns.PlayerOutfits
	local current = table.find(outfits, outfitFor(player)) or 1
	local nextId = outfits[current % #outfits + 1]
	player:SetAttribute("OutfitId", nextId)
	local character = PlayerData.GetAliveCharacter(player)
	if character then
		Outfitter.Apply(character, Designs[nextId])
	end
	StoryService.Toast(player, "Outfit: " .. Designs[nextId].Title, "info")
end

------------------------------------------------------------------------------
-- Story characters
------------------------------------------------------------------------------

type SpotRecord = { Spot: BasePart, Model: Model?, Phase: string }
local spots: { SpotRecord } = {}

-- A finished model for a story character, if one has been added in Studio
-- at ServerStorage > RiftfallAssets > Characters > <design id>.
local function libraryModel(design: CharacterDesigns.Design): Model?
	local library = ServerStorage:FindFirstChild("RiftfallAssets")
	local characters = library and library:FindFirstChild("Characters")
	local model = characters and characters:FindFirstChild(design.Id)
	if model and model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
		local copy = model:Clone()
		copy:SetAttribute("CustomModel", true)
		return copy
	end
	return nil
end

-- Builds a standing, posed R15 character for a design (or uses the
-- finished model from the asset library).
local function buildNPC(design: CharacterDesigns.Design): Model?
	local custom = libraryModel(design)
	if custom then
		custom.Name = design.DisplayName
		local humanoid = custom:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayName = design.DisplayName .. " - " .. design.Title
		end
		return custom
	end
	local description = Instance.new("HumanoidDescription")
	description.WidthScale = design.Width or 1
	description.DepthScale = design.Width or 1
	description.HeightScale = design.Height or 1
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[CharacterService] Could not build", design.Id, model)
		return nil
	end
	model.Name = design.DisplayName
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayName = design.DisplayName .. " - " .. design.Title
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		humanoid.NameDisplayDistance = 30
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.BreakJointsOnDeath = false
	end
	-- Remove the default animation script: these characters hold a pose.
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	Outfitter.Apply(model, design)
	return model
end

-- Places a model so it stands on the spot's position, facing its direction.
local function standOn(model: Model, spot: BasePart, slump: boolean)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	root.Anchored = true
	model.PrimaryPart = root
	-- Work out how far the root sits above the feet, then stand on the spot.
	local boxCFrame, boxSize = model:GetBoundingBox()
	local rootAboveFeet = root.Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
	local target = spot.CFrame + Vector3.new(0, rootAboveFeet - spot.Size.Y / 2 + 0.5, 0)
	if slump then
		-- Leaning back against the pillar, head hanging.
		target = target * CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(-22), 0, 0)
	end
	model:PivotTo(target)
end

local function addTalkPrompt(model: Model, characterId: string, phase: string)
	local dialogue = TALK_DIALOGUE[characterId]
	local root = model:FindFirstChild("HumanoidRootPart")
	if not dialogue or not root then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Talk"
	prompt.ObjectText = model.Name
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(player)
		if PlayerData.RateLimit(player, "Talk", 2) then
			StoryService.PlayDialogue(dialogue[phase] or dialogue.Explore, player)
		end
	end)
end

local function spawnOnSpot(record: SpotRecord)
	local id = record.Spot:GetAttribute("CharacterId")
	if type(id) ~= "string" or not Designs[id] then
		return
	end
	local model = buildNPC(Designs[id])
	if not model then
		return
	end
	standOn(model, record.Spot, id == "CorruptedSoldier")
	addTalkPrompt(model, id, record.Phase)
	record.Model = model
end

-- Shows the characters whose spot matches the current story phase.
local function refreshVisibility()
	local phase = StoryService.GetPhase()
	for _, record in spots do
		local model = record.Model
		local spot = record.Spot
		if model and spot.Parent then
			local visible = record.Phase == "Any" or record.Phase == phase
			model.Parent = if visible then spot.Parent else nil
		end
	end
end

local function bindSpot(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local phase = inst:GetAttribute("Phase")
	local record: SpotRecord = { Spot = inst, Model = nil, Phase = if type(phase) == "string" then phase else "Any" }
	table.insert(spots, record)
	spawnOnSpot(record)
	refreshVisibility()
	-- Forget spots (and their characters) when the level is rebuilt.
	inst.AncestryChanged:Connect(function()
		if inst:IsDescendantOf(workspace) then
			return
		end
		local index = table.find(spots, record)
		if index then
			table.remove(spots, index)
		end
		if record.Model then
			record.Model:Destroy()
		end
	end)
end

------------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------------

function CharacterService.Init()
	Remotes.ChangeOutfit.OnServerEvent:Connect(onChangeOutfit)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			dressPlayer(player, character)
		end)
		if player.Character then
			task.spawn(dressPlayer, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end

	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(refreshVisibility)
	Zones.BindTag("CharacterSpot", bindSpot)
end

-- Exposed for tests: dress any R15 model as a design id.
function CharacterService.DressModel(model: Model, designId: string): boolean
	local design = Designs[designId]
	return design ~= nil and Outfitter.Apply(model, design)
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CheckpointService</string>
            <string name="Source"><![CDATA[--!strict
-- CheckpointService: remembers each player's furthest checkpoint, respawns
-- them there after death, and handles falling off the map.
--
-- Checkpoints only move forward, so walking back past an old checkpoint
-- never sends you further back on your next death.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local StoryService = require(script.Parent.StoryService)

local CheckpointService = {}

-- Listeners notified when a player dies / spawns (set up by other services).
local diedListeners: { (Player) -> () } = {}
local spawnedListeners: { (Player, Model) -> () } = {}

function CheckpointService.OnPlayerDied(callback: (Player) -> ())
	table.insert(diedListeners, callback)
end

function CheckpointService.OnPlayerSpawned(callback: (Player, Model) -> ())
	table.insert(spawnedListeners, callback)
end

-- Sets a checkpoint if it is further along than the player's current one.
function CheckpointService.Set(player: Player, order: number, spawnPosition: Vector3, name: string?)
	local data = PlayerData.Get(player)
	if not data or order <= data.CheckpointOrder then
		return
	end
	data.CheckpointOrder = order
	data.CheckpointSpawn = spawnPosition
	if name then
		StoryService.Toast(player, "Checkpoint reached: " .. name, "checkpoint")
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not humanoid:IsA("Humanoid") or not root then
		return
	end
	local data = PlayerData.Get(player)
	if data and data.CheckpointSpawn then
		-- Wait one frame so the default spawn placement finishes first.
		task.defer(function()
			if character.Parent then
				character:PivotTo(CFrame.new(data.CheckpointSpawn :: Vector3) * CFrame.Angles(0, math.pi, 0))
			end
		end)
	end
	humanoid.Died:Connect(function()
		local d = PlayerData.Get(player)
		if d then
			d.Deaths += 1
		end
		for _, callback in diedListeners do
			task.spawn(callback, player)
		end
	end)
	for _, callback in spawnedListeners do
		task.spawn(callback, player, character)
	end
end

function CheckpointService.Init()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end

	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in Players:GetPlayers() do
				local _, humanoid, root = PlayerData.GetAliveCharacter(player)
				if not humanoid or not root then
					continue
				end
				-- Falling into the chasm (or out of the world) is fatal.
				if root.Position.Y < Config.World.KillHeight then
					humanoid.Health = 0
					continue
				end
				for _, zone in CollectionService:GetTagged("Checkpoint") do
					if zone:IsA("BasePart") and Zones.Contains(zone, root.Position) then
						local order = zone:GetAttribute("Order")
						local spawnPos = zone:GetAttribute("SpawnPosition")
						local name = zone:GetAttribute("CheckpointName")
						if type(order) == "number" and typeof(spawnPos) == "Vector3" then
							CheckpointService.Set(player, order, spawnPos, if type(name) == "string" then name else nil)
						end
					end
				end
			end
		end
	end)
end

return CheckpointService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">EscapeService</string>
            <string name="Source"><![CDATA[--!strict
-- EscapeService: the collapse set-piece after the door opens.
--
--  * Falling debris in the tunnel. Every rock is announced by a red warning
--    circle on the floor first, so it can always be dodged.
--  * The Rift Stalker is released behind the players after a short head start.
--  * The rope bridge planks fall away behind players as they cross.
--
-- If a player dies, they respawn at the temple door; the creature is moved
-- back and gives them the same head start again, and any fallen bridge
-- planks are restored, so the sequence can always be retried.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local StalkerService = require(script.Parent.StalkerService)
local CheckpointService = require(script.Parent.CheckpointService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local EscapeService = {}

local active = false
local rng = Random.new()

-- Tunnel bounds that debris may land in.
local TUNNEL_MIN_X, TUNNEL_MAX_X = -6, 6
local TUNNEL_MIN_Z, TUNNEL_MAX_Z = 363, 428
local CEILING_Y = 15.5
local DEBRIS_RADIUS = 4

local function effectsFolder(): Folder
	local folder = workspace:FindFirstChild("EscapeEffects")
	if folder and folder:IsA("Folder") then
		return folder
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "EscapeEffects"
	newFolder.Parent = workspace
	return newFolder
end

local function dropDebris(landing: Vector3)
	local folder = effectsFolder()
	local warning = Instance.new("Part")
	warning.Name = "DebrisWarning"
	warning.Shape = Enum.PartType.Cylinder
	warning.Size = Vector3.new(0.1, DEBRIS_RADIUS * 2, DEBRIS_RADIUS * 2)
	warning.CFrame = CFrame.new(landing + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	warning.Anchored = true
	warning.CanCollide = false
	warning.CanQuery = false
	warning.Material = Enum.Material.Neon
	warning.Color = Color3.fromRGB(255, 50, 40)
	warning.Transparency = 0.5
	warning.Parent = folder
	Debris:AddItem(warning, Config.Escape.DebrisWarningTime + 1)

	task.delay(Config.Escape.DebrisWarningTime, function()
		if not active then
			warning:Destroy()
			return
		end
		local rock = Instance.new("Part")
		rock.Name = "FallingRock"
		rock.Size = Vector3.new(3.5, 3, 3.5)
		rock.CFrame = CFrame.new(landing.X, CEILING_Y, landing.Z)
			* CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0)
		rock.Anchored = true
		-- Rocks never collide, so they can never wall off the tunnel.
		rock.CanCollide = false
		rock.CanQuery = false
		rock.Material = Enum.Material.Slate
		rock.Color = Color3.fromRGB(80, 74, 70)
		rock.Parent = folder
		local fall = TweenService:Create(rock, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = CFrame.new(landing.X, 1.5, landing.Z) * rock.CFrame.Rotation,
		})
		fall:Play()
		fall.Completed:Once(function()
			warning:Destroy()
			for _, player in Players:GetPlayers() do
				local _, humanoid, root = PlayerData.GetAliveCharacter(player)
				if humanoid and root then
					local offset = root.Position - landing
					if Vector3.new(offset.X, 0, offset.Z).Magnitude <= DEBRIS_RADIUS and root.Position.Y < 9 then
						humanoid:TakeDamage(Config.Escape.DebrisDamage)
						Remotes.CameraShake:FireClient(player, 0.5, 1.5)
					end
				end
			end
			TweenService:Create(rock, TweenInfo.new(1.5), { Transparency = 1 }):Play()
			Debris:AddItem(rock, 1.6)
		end)
	end)
end

local function playersInTunnel(): { BasePart }
	local roots = {}
	local zone = Zones.FirstTagged("EscapeZone")
	if not zone then
		return roots
	end
	for _, player in Players:GetPlayers() do
		local _, _, root = PlayerData.GetAliveCharacter(player)
		if root and Zones.Contains(zone, root.Position) then
			table.insert(roots, root)
		end
	end
	return roots
end

local function restoreBridge()
	for _, plank in CollectionService:GetTagged("BridgePlank") do
		if plank:IsA("BasePart") then
			local home = plank:GetAttribute("HomeCFrame")
			if typeof(home) == "CFrame" and (plank:GetAttribute("Fallen") or not plank.Anchored) then
				plank.Anchored = true
				plank.CFrame = home
				plank.AssemblyLinearVelocity = Vector3.zero
				plank.AssemblyAngularVelocity = Vector3.zero
				plank.Transparency = 0
				plank.CanCollide = true
				plank:SetAttribute("Fallen", nil)
			end
		end
	end
end

local function collapsePlank(plank: BasePart)
	plank:SetAttribute("Fallen", true)
	plank.Anchored = false
	-- Once it has fallen out of sight, hide it (kept for restoreBridge).
	task.delay(4, function()
		if plank.Parent and plank:GetAttribute("Fallen") then
			plank.Anchored = true
			plank.Transparency = 1
			plank.CanCollide = false
		end
	end)
end

-- Planks fall once every player who is on the bridge or beyond has passed
-- them, and nobody is still behind them on the route.
local function updateBridge()
	local furthestBack = math.huge
	local anyoneOnBridgeOrBeyond = false
	for _, player in Players:GetPlayers() do
		local _, _, root = PlayerData.GetAliveCharacter(player)
		if root then
			local pos = root.Position
			if pos.Z > 460 and pos.Y > 18 then
				anyoneOnBridgeOrBeyond = true
			end
			furthestBack = math.min(furthestBack, pos.Z)
		end
	end
	if not anyoneOnBridgeOrBeyond then
		return
	end
	for _, plank in CollectionService:GetTagged("BridgePlank") do
		if plank:IsA("BasePart") and plank.Anchored and not plank:GetAttribute("Fallen") then
			if plank.Position.Z < furthestBack - 6 then
				collapsePlank(plank)
			end
		end
	end
end

-- Someone standing on the cliff top while planks are missing means they
-- were left behind: rebuild the bridge so they are never stranded.
local function rescueStragglers()
	for _, player in Players:GetPlayers() do
		local data = PlayerData.Get(player)
		local _, _, root = PlayerData.GetAliveCharacter(player)
		if root and data and not data.Finished then
			local pos = root.Position
			if pos.Z > 445 and pos.Z < 461 and pos.Y > 18 then
				for _, plank in CollectionService:GetTagged("BridgePlank") do
					if plank:GetAttribute("Fallen") then
						restoreBridge()
						return
					end
				end
			end
		end
	end
end

function EscapeService.Begin()
	if active then
		return
	end
	active = true
	StalkerService.StartHunt(Config.Escape.HuntDelay)
end

function EscapeService.IsActive(): boolean
	return active
end

function EscapeService.Reset()
	active = false
	local folder = workspace:FindFirstChild("EscapeEffects")
	if folder then
		folder:ClearAllChildren()
	end
end

-- Called when a player dies during the escape.
local function onPlayerDied(player: Player)
	if not active then
		return
	end
	-- If nobody else is still running, put the creature back so the
	-- respawned player gets a fair head start again.
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local _, _, root = PlayerData.GetAliveCharacter(other)
			if root and root.Position.Z > 300 and root.Position.Z < 447 and root.Position.Y < 18 then
				return
			end
		end
	end
	StalkerService.StartHunt(Config.Escape.HuntDelay + Players.RespawnTime)
	restoreBridge()
end

function EscapeService.Init()
	CheckpointService.OnPlayerDied(onPlayerDied)

	task.spawn(function()
		local lastDebris = 0
		while true do
			task.wait(0.2)
			if not active then
				continue
			end
			local now = os.clock()
			if now - lastDebris >= Config.Escape.DebrisInterval then
				local roots = playersInTunnel()
				if #roots > 0 then
					lastDebris = now
					local root = roots[rng:NextInteger(1, #roots)]
					-- Aim near (and slightly ahead of) a running player.
					local x = math.clamp(root.Position.X + rng:NextNumber(-5, 5), TUNNEL_MIN_X, TUNNEL_MAX_X)
					local z = math.clamp(root.Position.Z + rng:NextNumber(-3, 12), TUNNEL_MIN_Z, TUNNEL_MAX_Z)
					dropDebris(Vector3.new(x, 0, z))
					if rng:NextNumber() < 0.35 then
						Remotes.CameraShake:FireAllClients(0.8, 0.5)
					end
				end
			end
			updateBridge()
			rescueStragglers()
		end
	end)
end

return EscapeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">FlashlightService</string>
            <string name="Source"><![CDATA[--!strict
-- FlashlightService: the server owns the battery level and whether the light
-- is on. The light and its visible beam sit on the character's head, so
-- other players see them too. Each client hides its own head light and shows
-- a local copy aimed along the camera instead (see FlashlightController).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FlashlightVisuals = require(ReplicatedStorage.Shared.FlashlightVisuals)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local StoryService = require(script.Parent.StoryService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local FlashlightService = {}

local rigs: { [Player]: FlashlightVisuals.Rig } = {}

local function createLight(player: Player, character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head or not head:IsA("BasePart") or character ~= player.Character then
		return
	end
	-- The head's Front face points where the character faces.
	rigs[player] = FlashlightVisuals.Create(head, 0.7)
end

function FlashlightService.SetOn(player: Player, on: boolean)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	if on and data.Battery <= 0 then
		StoryService.Toast(player, "Battery is dead. Find or use a Battery.", "warning")
		on = false
	end
	player:SetAttribute("FlashlightOn", on)
	local rig = rigs[player]
	if rig and rig.Light.Parent then
		FlashlightVisuals.SetEnabled(rig, on)
	end
end

local function onToggle(player: Player)
	if not PlayerData.RateLimit(player, "Flashlight", 0.2) then
		return
	end
	FlashlightService.SetOn(player, not player:GetAttribute("FlashlightOn"))
end

function FlashlightService.Init()
	Remotes.ToggleFlashlight.OnServerEvent:Connect(onToggle)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			player:SetAttribute("FlashlightOn", false)
			createLight(player, character)
		end)
		if player.Character then
			task.spawn(createLight, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		rigs[player] = nil
	end)

	-- Drain batteries of lights that are on.
	task.spawn(function()
		local STEP = 0.5
		while true do
			task.wait(STEP)
			for _, player in Players:GetPlayers() do
				if player:GetAttribute("FlashlightOn") then
					local data = PlayerData.Get(player)
					if data then
						data.Battery = math.max(0, data.Battery - Config.Flashlight.DrainPerSecond * STEP)
						player:SetAttribute("Battery", data.Battery)
						if data.Battery <= 0 then
							FlashlightService.SetOn(player, false)
						end
					end
				end
			end
		end
	end)
end

return FlashlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
-- GameService: the start and end of a run. Detects players reaching the
-- rescue flare, shows them their results, and handles "Play Again".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Story = require(ReplicatedStorage.Shared.Story)
local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local LevelBuilder = require(script.Parent.LevelBuilder)
local StoryService = require(script.Parent.StoryService)
local InventoryService = require(script.Parent.InventoryService)
local PuzzleService = require(script.Parent.PuzzleService)
local StalkerService = require(script.Parent.StalkerService)
local EscapeService = require(script.Parent.EscapeService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local GameService = {}

local function countNotes(): number
	local total = 0
	for _ in Story.Notes do
		total += 1
	end
	return total
end

local function finishRun(player: Player)
	local data = PlayerData.Get(player)
	if not data or data.Finished then
		return
	end
	data.Finished = true
	local notesRead = 0
	for _ in data.NotesRead do
		notesRead += 1
	end
	StoryService.SetObjective("Done")
	StoryService.PlayDialogue("Done", player)
	Remotes.RunComplete:FireClient(player, {
		Time = os.clock() - data.StartTime,
		Deaths = data.Deaths,
		NotesRead = notesRead,
		NotesTotal = countNotes(),
		FoundShard = InventoryService.Count(player, "RiftShard") > 0,
	})

	-- When every player has made it out, the set-piece is over.
	for _, other in Players:GetPlayers() do
		local otherData = PlayerData.Get(other)
		if otherData and not otherData.Finished then
			return
		end
	end
	EscapeService.Reset()
	StalkerService.Despawn()
end

-- Rebuilds the world and restarts every player from the beginning.
local function fullReset()
	EscapeService.Reset()
	PuzzleService.Reset()
	StoryService.Reset()
	LevelBuilder.Build()
	PuzzleService.Reset() -- Again, now that the new dials exist.
	StalkerService.SpawnPatrol()
	for _, player in Players:GetPlayers() do
		PlayerData.Reset(player)
		InventoryService.Sync(player)
		player:LoadCharacter()
		StoryService.PlayDialogue("Intro", player)
	end
end

local function onReplay(player: Player)
	if not PlayerData.RateLimit(player, "Replay", 3) then
		return
	end
	local data = PlayerData.Get(player)
	if not data or not data.Finished then
		return
	end
	for _, other in Players:GetPlayers() do
		local otherData = PlayerData.Get(other)
		if otherData and not otherData.Finished then
			-- Others are still playing: restart just this player, without
			-- resetting the world under everyone else's feet.
			PlayerData.Reset(player)
			InventoryService.Sync(player)
			player:LoadCharacter()
			return
		end
	end
	fullReset()
end

function GameService.Init()
	Remotes.RequestReplay.OnServerEvent:Connect(onReplay)

	task.spawn(function()
		while true do
			task.wait(0.25)
			local zone = Zones.FirstTagged("EndZone")
			if not zone then
				continue
			end
			for _, player in Players:GetPlayers() do
				local _, _, root = PlayerData.GetAliveCharacter(player)
				if root and Zones.Contains(zone, root.Position) then
					finishRun(player)
				end
			end
		end
	end)
end

return GameService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--!strict
-- InteractionService: item pickups and readable notes.
--
-- Both use Roblox ProximityPrompts, which already work with keyboard (E),
-- gamepad, and touch screens. The server double-checks distance before
-- granting anything, so a modified client cannot grab items from afar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Items = require(ReplicatedStorage.Shared.Items)
local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local InventoryService = require(script.Parent.InventoryService)
local StoryService = require(script.Parent.StoryService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MAX_INTERACT_DISTANCE = 14

local InteractionService = {}

local function closeEnough(player: Player, part: BasePart): boolean
	local _, _, root = PlayerData.GetAliveCharacter(player)
	return root ~= nil and (root.Position - part.Position).Magnitude <= MAX_INTERACT_DISTANCE
end

local function bindPickup(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local part = inst
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		return
	end
	prompt.Triggered:Connect(function(player)
		-- "Taken" guards against two players grabbing the same item at once.
		if part:GetAttribute("Taken") or not closeEnough(player, part) then
			return
		end
		local itemId = part:GetAttribute("ItemId")
		local count = part:GetAttribute("Count")
		if type(itemId) ~= "string" or type(count) ~= "number" or not Items[itemId] then
			return
		end
		part:SetAttribute("Taken", true)
		if InventoryService.Add(player, itemId, count) then
			StoryService.Toast(player, "Picked up " .. Items[itemId].DisplayName, "good")
			part:Destroy()
		else
			part:SetAttribute("Taken", nil)
			StoryService.Toast(player, "Inventory full. Use or drop something first.", "warning")
		end
	end)
end

local function bindNote(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local part = inst
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		return
	end
	prompt.Triggered:Connect(function(player)
		if not closeEnough(player, part) then
			return
		end
		local noteId = part:GetAttribute("NoteId")
		if type(noteId) ~= "string" then
			return
		end
		local data = PlayerData.Get(player)
		if data then
			data.NotesRead[noteId] = true
		end
		Remotes.ShowNote:FireClient(player, noteId)
	end)
end

function InteractionService.Init()
	Zones.BindTag("Pickup", bindPickup)
	Zones.BindTag("Note", bindNote)
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
-- InventoryService: a small slot-based inventory that lives only on the
-- server. Clients receive a read-only copy for the UI and can only *ask* to
-- use or drop a slot; every request is validated here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local StoryService = require(script.Parent.StoryService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local InventoryService = {}

-- Set by Main: spawns a world pickup (used when a player drops an item).
InventoryService.SpawnDroppedItem = nil :: ((itemId: string, position: Vector3) -> ())?

function InventoryService.Sync(player: Player)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	local copy = {}
	for i = 1, Config.Inventory.SlotCount do
		local slot = data.Inventory[i]
		copy[i] = if slot then { Id = slot.Id, Count = slot.Count } else false
	end
	Remotes.InventoryChanged:FireClient(player, copy)
end

-- Tries to add `count` of an item. Returns true only if everything fit.
function InventoryService.Add(player: Player, itemId: string, count: number): boolean
	local data = PlayerData.Get(player)
	local def = Items[itemId]
	if not data or not def then
		return false
	end
	-- Check capacity first so a partial add never happens.
	local room = 0
	for i = 1, Config.Inventory.SlotCount do
		local slot = data.Inventory[i]
		if slot == nil then
			room += def.MaxStack
		elseif slot.Id == itemId then
			room += def.MaxStack - slot.Count
		end
	end
	if room < count then
		return false
	end
	local remaining = count
	for i = 1, Config.Inventory.SlotCount do
		local slot = data.Inventory[i]
		if slot and slot.Id == itemId and slot.Count < def.MaxStack then
			local add = math.min(remaining, def.MaxStack - slot.Count)
			slot.Count += add
			remaining -= add
		end
		if remaining <= 0 then
			break
		end
	end
	for i = 1, Config.Inventory.SlotCount do
		if remaining <= 0 then
			break
		end
		if data.Inventory[i] == nil then
			local add = math.min(remaining, def.MaxStack)
			data.Inventory[i] = { Id = itemId, Count = add }
			remaining -= add
		end
	end
	InventoryService.Sync(player)
	return true
end

function InventoryService.Count(player: Player, itemId: string): number
	local data = PlayerData.Get(player)
	if not data then
		return 0
	end
	local total = 0
	for i = 1, Config.Inventory.SlotCount do
		local slot = data.Inventory[i]
		if slot and slot.Id == itemId then
			total += slot.Count
		end
	end
	return total
end

local function removeFromSlot(data: PlayerData.Data, slotIndex: number)
	local slot = data.Inventory[slotIndex]
	if not slot then
		return
	end
	slot.Count -= 1
	if slot.Count <= 0 then
		data.Inventory[slotIndex] = nil
	end
end

local function validSlotIndex(value: any): boolean
	return type(value) == "number" and value == math.floor(value) and value >= 1 and value <= Config.Inventory.SlotCount
end

local function onUseItem(player: Player, slotIndex: any)
	if not validSlotIndex(slotIndex) then
		return
	end
	local data = PlayerData.Get(player)
	if not data or data.Busy then
		return
	end
	if os.clock() - data.LastUse < Config.Inventory.UseCooldown then
		return
	end
	local slot = data.Inventory[slotIndex]
	if not slot then
		return
	end
	local def = Items[slot.Id]
	local _, humanoid = PlayerData.GetAliveCharacter(player)
	if not def or not humanoid then
		return
	end

	-- Decide whether the item would do anything before starting.
	if def.HealAmount then
		if humanoid.Health >= humanoid.MaxHealth then
			StoryService.Toast(player, "Already at full health", "warning")
			return
		end
	elseif def.BatteryAmount then
		if data.Battery >= Config.Flashlight.MaxBattery then
			StoryService.Toast(player, "Flashlight is already fully charged", "warning")
			return
		end
	else
		StoryService.Toast(player, def.DisplayName .. ": " .. def.Description, "info")
		return
	end

	data.Busy = true
	data.LastUse = os.clock()
	player:SetAttribute("UsingItem", def.DisplayName)
	task.wait(def.UseTime)
	player:SetAttribute("UsingItem", nil)
	data.Busy = false

	-- Re-validate after the delay: the player may have died or the slot changed.
	local _, humanoidAfter = PlayerData.GetAliveCharacter(player)
	local slotAfter = data.Inventory[slotIndex]
	if humanoidAfter ~= humanoid or not humanoidAfter or not slotAfter or slotAfter.Id ~= def.Id then
		return
	end
	removeFromSlot(data, slotIndex)
	if def.HealAmount then
		humanoidAfter.Health = math.min(humanoidAfter.MaxHealth, humanoidAfter.Health + def.HealAmount)
		StoryService.Toast(player, "+" .. def.HealAmount .. " health", "good")
	elseif def.BatteryAmount then
		data.Battery = math.min(Config.Flashlight.MaxBattery, data.Battery + def.BatteryAmount)
		player:SetAttribute("Battery", data.Battery)
		StoryService.Toast(player, "Flashlight recharged", "good")
	end
	InventoryService.Sync(player)
end

local function onDropItem(player: Player, slotIndex: any)
	if not validSlotIndex(slotIndex) or not PlayerData.RateLimit(player, "Drop", 0.4) then
		return
	end
	local data = PlayerData.Get(player)
	local _, _, root = PlayerData.GetAliveCharacter(player)
	if not data or not root or data.Busy then
		return
	end
	local slot = data.Inventory[slotIndex]
	if not slot then
		return
	end
	local def = Items[slot.Id]
	if not def or def.KeyItem then
		StoryService.Toast(player, "You can't drop that. You'll need it.", "warning")
		return
	end
	removeFromSlot(data, slotIndex)
	InventoryService.Sync(player)
	if InventoryService.SpawnDroppedItem then
		InventoryService.SpawnDroppedItem(def.Id, root.Position + root.CFrame.LookVector * 3 - Vector3.new(0, 2, 0))
	end
	StoryService.Toast(player, "Dropped " .. def.DisplayName, "info")
end

function InventoryService.Init()
	Remotes.UseItem.OnServerEvent:Connect(onUseItem)
	Remotes.DropItem.OnServerEvent:Connect(onDropItem)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">LevelBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- LevelBuilder: builds the whole Chapter 1 demo map out of simple parts.
--
-- Why build the map in code? It keeps the entire game in plain text files
-- (easy to review, version, and rebuild), and it lets "Play Again" reset the
-- world by rebuilding it. Gameplay services never hold direct references to
-- map parts; they find them through CollectionService tags, so a rebuilt map
-- is picked up automatically.
--
-- Layout (the player travels toward +Z, "north"):
--   Z  -20 ..  60  Crash site (spawn)
--   Z   60 .. 160  Jungle trail (claw marks + survivor note)
--   Z  160 .. 210  Abandoned camp (checkpoint, journal with puzzle clue)
--   Z  210 .. 300  Ruins courtyard (the Stalker patrols, tall grass to hide in)
--   Z  300 .. 360  Temple interior (dial puzzle, sealed door)
--   Z  360 .. 430  Collapsing tunnel (escape sequence)
--   Z  430 .. 460  Cliff (ladder truss up to Y 24)
--   Z  460 .. 510  Rope bridge over a chasm
--   Z  510 .. 545  Flare landing zone (end of demo)
--
-- Set dressing follows the "Chapter 1 environment" concept art (storm
-- jungle, root-wrapped stone arches, muddy camp with overgrown 4x4s, the
-- crashed helicopter, torches, cliffs and a mountain). The visual pieces are
-- built by Util/SceneryKit; this file decides where they go.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SceneryKit = require(script.Parent.Parent.Util.SceneryKit)

local LevelBuilder = {}

local LEVEL_NAME = "RiftfallLevel"

type PartProps = { [string]: any }

local currentLevel: Folder? = nil
-- Smooth terrain is static, so it is filled on the first build only.
local terrainFilled = false

-- Creates an anchored part with sensible defaults, applying any overrides.
local function makePart(parent: Instance, props: PartProps): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

-- Invisible, non-colliding box used as a trigger zone or marker.
local function makeZone(parent: Instance, name: string, cframe: CFrame, size: Vector3, tag: string): Part
	local zone = makePart(parent, {
		Name = name,
		CFrame = cframe,
		Size = size,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	CollectionService:AddTag(zone, tag)
	return zone
end

local function makePrompt(
	parent: Instance,
	actionText: string,
	objectText: string,
	holdDuration: number?
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration or 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function addLight(parent: Instance, color: Color3, range: number, brightness: number): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
	return light
end

-- A big text label painted on one face of a part (signs, dial symbols, mural).
local function addSurfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.3
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Fantasy
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = gui
	return label
end

------------------------------------------------------------------------------
-- Scenery helpers
------------------------------------------------------------------------------

local function makeTree(parent: Instance, position: Vector3, rng: Random)
	SceneryKit.Tree(parent, position, rng)
end

local function makeRock(parent: Instance, position: Vector3, size: Vector3, rng: Random)
	makePart(parent, {
		Name = "Rock",
		Size = size,
		CFrame = CFrame.new(position)
			* CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(70, 72, 74),
	})
end

-- Tall grass: purely visual blades plus an invisible "HidingSpot" zone.
local function makeGrassPatch(parent: Instance, center: Vector3, size: Vector2, rng: Random)
	local model = Instance.new("Model")
	model.Name = "TallGrass"
	makeZone(
		model,
		"HidingZone",
		CFrame.new(center + Vector3.new(0, 3, 0)),
		Vector3.new(size.X, 6, size.Y),
		"HidingSpot"
	)
	local bladeCount = math.floor(size.X * size.Y / 6)
	for _ = 1, bladeCount do
		local h = rng:NextNumber(3.5, 5.5)
		local offset =
			Vector3.new(rng:NextNumber(-size.X / 2, size.X / 2), h / 2, rng:NextNumber(-size.Y / 2, size.Y / 2))
		makePart(model, {
			Name = "Blade",
			Size = Vector3.new(0.4, h, 0.4),
			CFrame = CFrame.new(center + offset)
				* CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, math.pi), rng:NextNumber(-0.25, 0.25)),
			Material = Enum.Material.Grass,
			Color = Color3.fromRGB(64, 92 + rng:NextInteger(0, 25), 44),
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
		})
	end
	model.Parent = parent
end

local function makePickup(parent: Instance, itemId: string, displayName: string, position: Vector3, color: Color3)
	local part = makePart(parent, {
		Name = itemId .. "Pickup",
		Size = Vector3.new(1.2, 1.2, 1.2),
		Position = position,
		Material = Enum.Material.Neon,
		Color = color,
		CanCollide = false,
		CastShadow = false,
	})
	part:SetAttribute("ItemId", itemId)
	part:SetAttribute("Count", 1)
	-- A faint glow keeps pickups findable on low graphics settings (fairness).
	addLight(part, color, 8, 0.8)
	makePrompt(part, "Pick up", displayName)
	CollectionService:AddTag(part, "Pickup")
end

local function makeNote(parent: Instance, noteId: string, label: string, position: Vector3)
	local part = makePart(parent, {
		Name = noteId .. "Note",
		Size = Vector3.new(1.4, 0.1, 1.8),
		CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(15), 0),
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(225, 215, 180),
		CanCollide = false,
	})
	part:SetAttribute("NoteId", noteId)
	addLight(part, Color3.fromRGB(255, 240, 200), 6, 0.6)
	makePrompt(part, "Read", label)
	CollectionService:AddTag(part, "Note")
end

local function makeCheckpoint(parent: Instance, name: string, order: number, position: Vector3)
	local pad = makePart(parent, {
		Name = "Checkpoint_" .. name,
		Size = Vector3.new(6, 0.4, 6),
		Position = position + Vector3.new(0, 0.2, 0),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(60, 60, 64),
	})
	local flare = makePart(parent, {
		Name = "CheckpointFlare",
		Size = Vector3.new(0.4, 2.5, 0.4),
		Position = position + Vector3.new(2.5, 1.65, 2.5),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(80, 255, 140),
		CanCollide = false,
	})
	addLight(flare, Color3.fromRGB(80, 255, 140), 14, 1)
	local zone = makeZone(
		parent,
		"CheckpointZone_" .. name,
		CFrame.new(position + Vector3.new(0, 4, 0)),
		Vector3.new(14, 8, 14),
		"Checkpoint"
	)
	zone:SetAttribute("CheckpointName", name)
	zone:SetAttribute("Order", order)
	zone:SetAttribute("SpawnPosition", pad.Position + Vector3.new(0, 3.5, 0))
end

-- Where a story character stands. CharacterService spawns the character on
-- it; Phase limits it to "Explore" (before the door opens) or "Escape"
-- (after), or "Any".
local function makeCharacterSpot(
	parent: Instance,
	characterId: string,
	position: Vector3,
	lookAt: Vector3,
	phase: string
)
	local flatTarget = Vector3.new(lookAt.X, position.Y, lookAt.Z)
	local spot = makeZone(
		parent,
		"Spot_" .. characterId .. "_" .. phase,
		CFrame.lookAt(position, flatTarget),
		Vector3.new(1, 1, 1),
		"CharacterSpot"
	)
	spot:SetAttribute("CharacterId", characterId)
	spot:SetAttribute("Phase", phase)
end

local function makeStoryTrigger(parent: Instance, triggerId: string, cframe: CFrame, size: Vector3)
	local zone = makeZone(parent, "Trigger_" .. triggerId, cframe, size, "StoryTrigger")
	zone:SetAttribute("TriggerId", triggerId)
end

local function makeWall(
	parent: Instance,
	from: Vector3,
	to: Vector3,
	height: number,
	thickness: number,
	material: Enum.Material,
	color: Color3,
	transparency: number?
)
	local mid = (from + to) / 2
	local length = (to - from).Magnitude
	makePart(parent, {
		Name = "Wall",
		Size = Vector3.new(thickness, height, length),
		CFrame = CFrame.lookAt(mid + Vector3.new(0, height / 2, 0), to + Vector3.new(0, height / 2, 0)),
		Material = material,
		Color = color,
		Transparency = transparency or 0,
	})
end

------------------------------------------------------------------------------
-- Sections
------------------------------------------------------------------------------

-- Returns the X position of the trail's center line at a given Z, so trees
-- can avoid it. The trail gently winds instead of being a straight corridor.
local function trailCenterX(z: number): number
	return math.sin(z / 28) * 9
end

-- Invisible boundary walls so players cannot walk off the map.
local function buildBounds(ground: Folder)
	local boundary = Color3.new(0, 0, 0)
	makeWall(
		ground,
		Vector3.new(-65, 0, -20),
		Vector3.new(-65, 0, 445),
		60,
		2,
		Enum.Material.SmoothPlastic,
		boundary,
		1
	)
	makeWall(ground, Vector3.new(65, 0, -20), Vector3.new(65, 0, 445), 60, 2, Enum.Material.SmoothPlastic, boundary, 1)
	makeWall(ground, Vector3.new(-65, 0, -20), Vector3.new(65, 0, -20), 60, 2, Enum.Material.SmoothPlastic, boundary, 1)
	-- The temple is the only way forward: block the gaps beside it.
	makeWall(
		ground,
		Vector3.new(-65, 0, 300),
		Vector3.new(-27, 0, 300),
		60,
		2,
		Enum.Material.SmoothPlastic,
		boundary,
		1
	)
	makeWall(ground, Vector3.new(27, 0, 300), Vector3.new(65, 0, 300), 60, 2, Enum.Material.SmoothPlastic, boundary, 1)
end

local function buildGroundAndBounds(level: Folder)
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = level

	-- In Roblox the ground is smooth terrain (see buildTerrain); the flat
	-- floor and trail parts are only the fallback for the offline tests.
	if SceneryKit.Terrain then
		buildBounds(ground)
		return
	end
	makePart(ground, {
		Name = "JungleFloor",
		Size = Vector3.new(130, 2, 465),
		Position = Vector3.new(0, -1, 212.5),
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(46, 66, 38),
	})
	-- Dirt trail segments that follow trailCenterX.
	for z = -10, 205, 10 do
		makePart(ground, {
			Name = "Trail",
			Size = Vector3.new(9, 0.2, 11),
			CFrame = CFrame.new(trailCenterX(z), 0.05, z) * CFrame.Angles(0, math.atan(math.cos(z / 28) * 9 / 28), 0),
			Material = Enum.Material.Mud,
			Color = Color3.fromRGB(78, 62, 46),
			CanCollide = false,
		})
	end
	buildBounds(ground)
end

local function buildJungle(level: Folder, rng: Random)
	local jungle = Instance.new("Folder")
	jungle.Name = "Jungle"
	jungle.Parent = level

	-- Clearings where trees must not grow (center X, center Z, radius).
	local clearings = {
		{ 0, 15, 26 }, -- crash site
		{ 0, 185, 26 }, -- camp
	}
	local function isClear(x: number, z: number): boolean
		if z < 150 or z > 205 then
			if math.abs(x - trailCenterX(z)) < 9 then
				return true
			end
		end
		for _, c in clearings do
			if (Vector2.new(x, z) - Vector2.new(c[1], c[2])).Magnitude < c[3] then
				return true
			end
		end
		return false
	end

	local placed = 0
	local attempts = 0
	while placed < 170 and attempts < 2000 do
		attempts += 1
		local x = rng:NextNumber(-62, 62)
		local z = rng:NextNumber(-18, 212)
		if not isClear(x, z) then
			makeTree(jungle, Vector3.new(x, 0, z), rng)
			placed += 1
		end
	end
	-- A thinner tree line framing the ruins courtyard.
	for z = 215, 295, 12 do
		makeTree(jungle, Vector3.new(-58 + rng:NextNumber(-2, 2), 0, z), rng)
		makeTree(jungle, Vector3.new(58 + rng:NextNumber(-2, 2), 0, z), rng)
	end
	-- Ferns carpet the jungle floor, thickest along the trail edges.
	local ferns = 0
	attempts = 0
	while ferns < 110 and attempts < 1500 do
		attempts += 1
		local z = rng:NextNumber(-15, 210)
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local x = trailCenterX(z) + side * rng:NextNumber(6, 40)
		if math.abs(x) < 62 and not ((Vector2.new(x, z) - Vector2.new(0, 185)).Magnitude < 22) then
			SceneryKit.Fern(jungle, Vector3.new(x, 0, z), rng)
			ferns += 1
		end
	end
	-- Scattered bushes of tall grass along the trail edges (also hideable).
	makeGrassPatch(jungle, Vector3.new(trailCenterX(120) + 8, 0, 120), Vector2.new(6, 8), rng)
	makeGrassPatch(jungle, Vector3.new(trailCenterX(80) - 8, 0, 80), Vector2.new(6, 8), rng)
end

local function buildCrashSite(level: Folder, rng: Random)
	local site = Instance.new("Folder")
	site.Name = "CrashSite"
	site.Parent = level

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "StartSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0 -- No force-field: there is nothing to protect against here.
	spawn.Size = Vector3.new(6, 0.4, 6)
	spawn.Position = Vector3.new(0, 0.2, 2)
	spawn.Material = Enum.Material.Slate
	spawn.Color = Color3.fromRGB(60, 60, 64)
	spawn.Parent = site

	-- The crashed helicopter, still smouldering.
	local firePoint = SceneryKit.Helicopter(site, CFrame.new(-15, 0, 18) * CFrame.Angles(0, math.rad(25), 0), rng)
	local fireSource = makePart(site, {
		Name = "FireSource",
		Size = Vector3.new(2, 1, 2),
		Position = firePoint + Vector3.new(1, 0, -2),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 9
	fire.Parent = fireSource
	local smoke = Instance.new("Smoke")
	smoke.RiseVelocity = 6
	smoke.Size = 6
	smoke.Opacity = 0.15
	smoke.Color = Color3.fromRGB(40, 40, 40)
	smoke.Parent = fireSource
	addLight(fireSource, Color3.fromRGB(255, 140, 60), 30, 2)

	-- An abandoned expedition 4x4, headlights still on, lighting the way
	-- into the jungle.
	SceneryKit.Truck(site, CFrame.lookAt(Vector3.new(17, 0, 24), Vector3.new(9, 0, 56)), rng)
	SceneryKit.MudPatch(site, Vector3.new(4, 0, 18), Vector2.new(26, 22), rng)
	SceneryKit.Torch(site, Vector3.new(-3, 0, 30))

	-- Supply crates.
	for i, pos in { Vector3.new(8, 1.5, 14), Vector3.new(11, 1.5, 18), Vector3.new(9, 4.5, 15) } do
		makePart(site, {
			Name = "Crate" .. i,
			Size = Vector3.new(3, 3, 3),
			CFrame = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 1), 0),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(110, 84, 56),
		})
	end
	makePickup(site, "Battery", "Battery", Vector3.new(6, 1, 19), Color3.fromRGB(120, 200, 255))

	-- Serra's hologram projects from a crashed comms drone near the spawn.
	local projector = makePart(site, {
		Name = "HoloProjector",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 3.2, 3.2),
		CFrame = CFrame.new(6, 0.15, 8) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(70, 220, 255),
		CanCollide = false,
	})
	addLight(projector, Color3.fromRGB(70, 220, 255), 12, 1.2)
	makeCharacterSpot(site, "Serra", Vector3.new(6, 0.3, 8), Vector3.new(0, 0, 2), "Any")

	-- A rusted sign pointing the way.
	local post = makePart(site, {
		Name = "SignPost",
		Size = Vector3.new(0.6, 6, 0.6),
		Position = Vector3.new(6, 3, 34),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(70, 52, 38),
	})
	local board = makePart(site, {
		Name = "SignBoard",
		Size = Vector3.new(6, 2, 0.3),
		Position = post.Position + Vector3.new(0, 2, -0.45),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(96, 74, 52),
	})
	addSurfaceText(board, Enum.NormalId.Front, "RIFT ZONE - KEEP OUT", Color3.fromRGB(200, 60, 50))
end

local function buildTrail(level: Folder)
	local trail = Instance.new("Folder")
	trail.Name = "Trail"
	trail.Parent = level

	-- Claw marks on a tree beside the trail: the creature is introduced
	-- through clues before the player ever sees it.
	local z = 110
	local treePos = Vector3.new(trailCenterX(z) - 7, 0, z)
	makePart(trail, {
		Name = "MarkedTree",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(26, 5, 5),
		CFrame = CFrame.new(treePos + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(58, 44, 34),
	})
	for i = 1, 4 do
		makePart(trail, {
			Name = "ClawMark",
			Size = Vector3.new(0.3, 4, 0.3),
			CFrame = CFrame.new(treePos + Vector3.new(2.45, 6 + i * 0.2, -1.5 + i * 0.7))
				* CFrame.Angles(math.rad(25), 0, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(120, 30, 40),
			CanCollide = false,
		})
	end
	makePart(trail, {
		Name = "BrokenCrate",
		Size = Vector3.new(3, 2, 3),
		CFrame = CFrame.new(treePos + Vector3.new(4, 1, 3)) * CFrame.Angles(0, 0.4, 0.15),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(96, 74, 52),
	})
	makeNote(trail, "Scrawl", "Scratched message", treePos + Vector3.new(4, 2.1, 3))
	makeStoryTrigger(trail, "ClawMarks", CFrame.new(trailCenterX(z), 4, z), Vector3.new(24, 8, 14))
end

local function buildCamp(level: Folder, rng: Random)
	local camp = Instance.new("Folder")
	camp.Name = "Camp"
	camp.Parent = level

	-- Muddy ground churned up by boots and tyres.
	SceneryKit.MudPatch(camp, Vector3.new(0, 0, 186), Vector2.new(44, 38), rng)

	-- A-frame tents (one torn open), facing the campfire.
	local fireSpot = Vector3.new(2, 0, 186)
	for i, t in { { -12, 178 }, { 12, 194 }, { -9, 199 } } do
		local pos = Vector3.new(t[1], 0, t[2])
		SceneryKit.Tent(camp, CFrame.lookAt(pos, fireSpot), SceneryKit.Colors.Canvas, i == 2)
	end

	-- Two overgrown 4x4s parked at the edges, headlights on.
	SceneryKit.Truck(camp, CFrame.lookAt(Vector3.new(-22, 0, 201), Vector3.new(-2, 0, 184)), rng)
	SceneryKit.Truck(camp, CFrame.lookAt(Vector3.new(21, 0, 176), Vector3.new(2, 0, 190)), rng)

	-- Equipment cases and crates.
	SceneryKit.Cases(camp, CFrame.new(-16, 0, 172) * CFrame.Angles(0, 0.4, 0), rng)
	SceneryKit.Cases(camp, CFrame.new(14, 0, 203) * CFrame.Angles(0, -0.3, 0), rng)
	SceneryKit.Cases(camp, CFrame.new(-2, 0, 204) * CFrame.Angles(0, 0.1, 0), rng)

	-- Torches around the camp keep it readable at night.
	for _, pos in
		{ Vector3.new(-7, 0, 168), Vector3.new(10, 0, 168), Vector3.new(-18, 0, 190), Vector3.new(17, 0, 196) }
	do
		SceneryKit.Torch(camp, pos)
	end

	-- Campfire (cold ashes with a dim ember glow).
	local fire = makePart(camp, {
		Name = "Campfire",
		Size = Vector3.new(4, 0.5, 4),
		Position = Vector3.new(2, 0.25, 186),
		Material = Enum.Material.Cobblestone,
		Color = Color3.fromRGB(40, 36, 34),
	})
	addLight(fire, Color3.fromRGB(255, 90, 40), 14, 1.2)

	local tableTop = makePart(camp, {
		Name = "FieldTable",
		Size = Vector3.new(6, 0.4, 3),
		Position = Vector3.new(-4, 3, 194),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(110, 84, 56),
	})
	for _, off in
		{
			Vector3.new(-2.6, -1.5, -1.2),
			Vector3.new(2.6, -1.5, -1.2),
			Vector3.new(-2.6, -1.5, 1.2),
			Vector3.new(2.6, -1.5, 1.2),
		}
	do
		makePart(camp, {
			Name = "TableLeg",
			Size = Vector3.new(0.4, 2.8, 0.4),
			Position = tableTop.Position + off,
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(70, 52, 38),
		})
	end
	local lantern = makePart(camp, {
		Name = "Lantern",
		Size = Vector3.new(0.8, 1.2, 0.8),
		Position = tableTop.Position + Vector3.new(2, 0.8, 0),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 200, 120),
	})
	addLight(lantern, Color3.fromRGB(255, 200, 120), 16, 1.2)

	makeNote(camp, "Journal", "Rourke's journal", tableTop.Position + Vector3.new(-1, 0.25, 0))
	makePickup(camp, "Bandage", "Bandage", Vector3.new(12, 1, 184), Color3.fromRGB(230, 225, 210))
	makePickup(camp, "Battery", "Battery", Vector3.new(-14, 1, 186), Color3.fromRGB(120, 200, 255))
	makeCheckpoint(camp, "Camp", 1, Vector3.new(6, 0, 174))
	makeCharacterSpot(camp, "Kade", Vector3.new(-3, 0, 181), Vector3.new(0, 0, 168), "Explore")
	makeStoryTrigger(camp, "Camp", CFrame.new(0, 4, 172), Vector3.new(40, 8, 10))

	-- Scattered gear.
	for _ = 1, 6 do
		makePart(camp, {
			Name = "Debris",
			Size = Vector3.new(rng:NextNumber(1, 2.5), rng:NextNumber(0.5, 1.5), rng:NextNumber(1, 2.5)),
			CFrame = CFrame.new(rng:NextNumber(-18, 18), 0.5, rng:NextNumber(170, 205))
				* CFrame.Angles(0, rng:NextNumber(0, 3), 0),
			Material = Enum.Material.Fabric,
			Color = Color3.fromRGB(80, 70, 60),
		})
	end
end

local function buildRuins(level: Folder, rng: Random)
	local ruins = Instance.new("Folder")
	ruins.Name = "Ruins"
	ruins.Parent = level

	local stone = Color3.fromRGB(96, 98, 92)
	makePart(ruins, {
		Name = "CourtyardFloor",
		Size = Vector3.new(90, 0.4, 85),
		Position = Vector3.new(0, 0.2, 257),
		Material = Enum.Material.Cobblestone,
		Color = Color3.fromRGB(80, 82, 76),
	})

	-- Broken pillars (good cover for breaking line of sight).
	local pillarSpots = {
		Vector3.new(-30, 0, 228),
		Vector3.new(30, 0, 228),
		Vector3.new(-30, 0, 255),
		Vector3.new(30, 0, 255),
		Vector3.new(-30, 0, 282),
		Vector3.new(30, 0, 282),
		Vector3.new(-12, 0, 240),
		Vector3.new(14, 0, 268),
	}
	for _, pos in pillarSpots do
		local h = rng:NextNumber(6, 16)
		local pillar = makePart(ruins, {
			Name = "Pillar",
			Size = Vector3.new(4, h, 4),
			Position = pos + Vector3.new(0, h / 2, 0),
			Material = Enum.Material.Slate,
			Color = stone,
		})
		SceneryKit.MossCap(ruins, pillar)
		SceneryKit.DrapeRoots(ruins, pos + Vector3.new(0, h, 0), 0.4, rng:NextInteger(1, 3), rng)
	end

	-- Moss-covered stone archways strangled by roots: a great gate where the
	-- trail enters the ruins, one framing the temple doorway, and broken
	-- arches along the sides.
	SceneryKit.Arch(ruins, CFrame.new(4, 0.4, 214), { Width = 18, Height = 12, Rng = rng })
	SceneryKit.Arch(ruins, CFrame.new(0, 0.4, 294), { Width = 14, Height = 11, Rng = rng })
	SceneryKit.Arch(
		ruins,
		CFrame.new(-46, 0.4, 262) * CFrame.Angles(0, math.rad(90), 0),
		{ Width = 13, Height = 10, Broken = true, Rng = rng }
	)
	SceneryKit.Arch(
		ruins,
		CFrame.new(46, 0.4, 245) * CFrame.Angles(0, math.rad(90), 0),
		{ Width = 13, Height = 9, Broken = true, Rng = rng }
	)
	for _, pos in
		{ Vector3.new(-9, 0.4, 211), Vector3.new(17, 0.4, 211), Vector3.new(-12, 0.4, 291), Vector3.new(12, 0.4, 291) }
	do
		SceneryKit.Torch(ruins, pos)
	end
	for _ = 1, 18 do
		SceneryKit.Fern(ruins, Vector3.new(rng:NextNumber(-44, 44), 0.4, rng:NextNumber(216, 296)), rng)
	end

	-- Ancient stairs climbing out of the valley toward the cliffs (scenery,
	-- beyond the boundary).
	for _, side in { -1, 1 } do
		local foot = Vector3.new(side * 68, 0, 262)
		SceneryKit.Stairs(ruins, CFrame.lookAt(foot, foot + Vector3.new(side, 0, 0)), 18, 9, rng)
		-- Torches stand on the stair edge, on top of the step below them.
		for i = 0, 2 do
			local along = 2 + i * 12
			local stepTop = math.floor(along / 1.8) + 1
			SceneryKit.Torch(ruins, foot + Vector3.new(side * along, stepTop, 3.8), 4)
		end
	end
	-- Low crumbling walls.
	makeWall(ruins, Vector3.new(-22, 0, 246), Vector3.new(-8, 0, 250), 4, 2, Enum.Material.Slate, stone)
	makeWall(ruins, Vector3.new(6, 0, 236), Vector3.new(20, 0, 240), 5, 2, Enum.Material.Slate, stone)
	makeWall(ruins, Vector3.new(-6, 0, 274), Vector3.new(8, 0, 276), 3.5, 2, Enum.Material.Slate, stone)
	for _ = 1, 10 do
		local s = rng:NextNumber(2, 5)
		makeRock(
			ruins,
			Vector3.new(rng:NextNumber(-40, 40), s / 3, rng:NextNumber(220, 295)),
			Vector3.new(s, s * 0.7, s),
			rng
		)
	end

	-- Tall grass patches to hide in.
	makeGrassPatch(ruins, Vector3.new(-20, 0.4, 232), Vector2.new(10, 10), rng)
	makeGrassPatch(ruins, Vector3.new(22, 0.4, 250), Vector2.new(10, 12), rng)
	makeGrassPatch(ruins, Vector3.new(-18, 0.4, 266), Vector2.new(12, 10), rng)
	makeGrassPatch(ruins, Vector3.new(4, 0.4, 286), Vector2.new(14, 8), rng)
	makeGrassPatch(ruins, Vector3.new(-38, 0.4, 290), Vector2.new(8, 8), rng)

	makePickup(ruins, "Bandage", "Bandage", Vector3.new(-38, 1, 222), Color3.fromRGB(230, 225, 210))

	-- A dormant Corrupted Soldier slumped against a pillar (a warning of
	-- what the Rift does to people; it wakes up in a later milestone).
	makeCharacterSpot(ruins, "CorruptedSoldier", Vector3.new(-27.2, 0.4, 258), Vector3.new(0, 0.4, 262), "Any")
	local soldierReader = makePart(ruins, {
		Name = "SoldierReader",
		Size = Vector3.new(4, 5, 4),
		Position = Vector3.new(-25.5, 2.5, 258),
		Transparency = 1,
		CanCollide = false,
	})
	soldierReader:SetAttribute("NoteId", "Soldier")
	makePrompt(soldierReader, "Examine", "Fallen soldier")
	CollectionService:AddTag(soldierReader, "Note")

	-- Stalker patrol route (invisible markers, visited in order).
	local patrol = {
		Vector3.new(0, 3, 230),
		Vector3.new(-25, 3, 240),
		Vector3.new(-25, 3, 275),
		Vector3.new(0, 3, 292),
		Vector3.new(25, 3, 275),
		Vector3.new(25, 3, 240),
	}
	for i, pos in patrol do
		local marker = makeZone(ruins, "PatrolPoint" .. i, CFrame.new(pos), Vector3.new(1, 1, 1), "StalkerPatrol")
		marker:SetAttribute("Order", i)
	end
	makeZone(ruins, "StalkerSpawn", CFrame.new(0, 4, 292), Vector3.new(1, 1, 1), "StalkerSpawn")
	makeStoryTrigger(ruins, "Ruins", CFrame.new(0, 4, 214), Vector3.new(100, 8, 8))
end

local function buildTemple(level: Folder)
	local temple = Instance.new("Folder")
	temple.Name = "Temple"
	temple.Parent = level

	local stone = Color3.fromRGB(84, 82, 76)
	local mat = Enum.Material.Slate
	local height = 22

	makePart(temple, {
		Name = "TempleFloor",
		Size = Vector3.new(50, 0.4, 60),
		Position = Vector3.new(0, 0.2, 330),
		Material = Enum.Material.Cobblestone,
		Color = Color3.fromRGB(64, 62, 58),
	})
	makePart(temple, {
		Name = "Roof",
		Size = Vector3.new(54, 3, 64),
		Position = Vector3.new(0, height + 1.5, 330),
		Material = mat,
		Color = stone,
	})
	-- Stepped upper tiers make the temple read as an ancient ziggurat, with
	-- roots and moss pouring over it.
	for i, size in { Vector3.new(46, 6, 52), Vector3.new(34, 6, 40), Vector3.new(20, 5, 26) } do
		local tier = makePart(temple, {
			Name = "Tier" .. i,
			Size = size,
			Position = Vector3.new(0, height + 3 + (i - 0.5) * 6 - (if i == 3 then 0.5 else 0), 332),
			Material = mat,
			Color = stone,
		})
		SceneryKit.MossCap(temple, tier)
	end
	local rootRng = Random.new(42)
	for _, x in { -22, -12, 12, 22 } do
		SceneryKit.DrapeRoots(temple, Vector3.new(x, height + 2, 299), 0.4, 2, rootRng)
	end

	-- Side walls.
	makePart(temple, {
		Name = "WallWest",
		Size = Vector3.new(3, height, 60),
		Position = Vector3.new(-26.5, height / 2, 330),
		Material = mat,
		Color = stone,
	})
	makePart(temple, {
		Name = "WallEast",
		Size = Vector3.new(3, height, 60),
		Position = Vector3.new(26.5, height / 2, 330),
		Material = mat,
		Color = stone,
	})
	-- Front wall with an 8-wide doorway at X = 0.
	makePart(temple, {
		Name = "FrontLeft",
		Size = Vector3.new(24, height, 3),
		Position = Vector3.new(-16, height / 2, 300),
		Material = mat,
		Color = stone,
	})
	makePart(temple, {
		Name = "FrontRight",
		Size = Vector3.new(24, height, 3),
		Position = Vector3.new(16, height / 2, 300),
		Material = mat,
		Color = stone,
	})
	makePart(temple, {
		Name = "FrontLintel",
		Size = Vector3.new(8, height - 12, 3),
		Position = Vector3.new(0, 12 + (height - 12) / 2, 300),
		Material = mat,
		Color = stone,
	})
	-- Back wall with a 10-wide sealed door at X = 0.
	makePart(temple, {
		Name = "BackLeft",
		Size = Vector3.new(23, height, 3),
		Position = Vector3.new(-16.5, height / 2, 360),
		Material = mat,
		Color = stone,
	})
	makePart(temple, {
		Name = "BackRight",
		Size = Vector3.new(23, height, 3),
		Position = Vector3.new(16.5, height / 2, 360),
		Material = mat,
		Color = stone,
	})
	makePart(temple, {
		Name = "BackLintel",
		Size = Vector3.new(10, height - 14, 3),
		Position = Vector3.new(0, 14 + (height - 14) / 2, 360),
		Material = mat,
		Color = stone,
	})

	local gate = makePart(temple, {
		Name = "SealedDoor",
		Size = Vector3.new(10, 14, 2),
		Position = Vector3.new(0, 7, 359.5),
		Material = Enum.Material.Basalt,
		Color = Color3.fromRGB(50, 46, 60),
	})
	gate:SetAttribute("ClosedPosition", gate.Position)
	CollectionService:AddTag(gate, "PuzzleGate")
	addSurfaceText(gate, Enum.NormalId.Front, "◆", Color3.fromRGB(150, 90, 220))

	-- The mural above the door: shows EYE ? SUN (the journal fills the gap).
	local mural = makePart(temple, {
		Name = "Mural",
		Size = Vector3.new(18, 5, 0.4),
		Position = Vector3.new(0, 17, 358.3),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(110, 104, 92),
	})
	addSurfaceText(mural, Enum.NormalId.Front, "EYE     ?     SUN", Color3.fromRGB(230, 200, 140))
	local muralReader = makePart(temple, {
		Name = "MuralReader",
		Size = Vector3.new(4, 4, 1),
		Position = Vector3.new(-9, 3, 357),
		Transparency = 1,
		CanCollide = false,
	})
	muralReader:SetAttribute("NoteId", "Mural")
	makePrompt(muralReader, "Examine", "Temple mural")
	CollectionService:AddTag(muralReader, "Note")

	-- Three dials in front of the door.
	for i, x in { -8, 0, 8 } do
		local dial = makePart(temple, {
			Name = "Dial" .. i,
			Size = Vector3.new(4, 6, 4),
			Position = Vector3.new(x, 3, 346),
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(100, 96, 88),
		})
		dial:SetAttribute("DialIndex", i)
		local face = makePart(temple, {
			Name = "DialFace" .. i,
			Size = Vector3.new(3.4, 2.4, 0.2),
			Position = Vector3.new(x, 4.4, 343.9),
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(40, 38, 36),
			CanCollide = false,
		})
		local label = addSurfaceText(face, Enum.NormalId.Front, "?", Color3.new(1, 1, 1))
		label.Name = "SymbolLabel"
		face:SetAttribute("DialIndex", i)
		CollectionService:AddTag(face, "PuzzleDialFace")
		addLight(face, Color3.fromRGB(200, 170, 120), 6, 0.5)
		makePrompt(dial, "Turn", "Stone dial " .. i)
		CollectionService:AddTag(dial, "PuzzleDial")
	end

	-- Torches flanking the door give just enough light to read the dials.
	for _, x in { -11, 11 } do
		local torch = makePart(temple, {
			Name = "Torch",
			Size = Vector3.new(0.6, 1.4, 0.6),
			Position = Vector3.new(x, 8, 357.8),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 150, 70),
			CanCollide = false,
		})
		addLight(torch, Color3.fromRGB(255, 140, 60), 18, 1.4)
		local fire = Instance.new("Fire")
		fire.Size = 2
		fire.Heat = 4
		fire.Parent = torch
	end

	-- Side altar with optional evidence (the Rift Shard) and a torn page.
	local altar = makePart(temple, {
		Name = "Altar",
		Size = Vector3.new(5, 3, 3),
		Position = Vector3.new(-20, 1.5, 330),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(70, 66, 80),
	})
	makePickup(
		temple,
		"RiftShard",
		"Rift Shard",
		altar.Position + Vector3.new(0.8, 2.2, 0),
		Color3.fromRGB(190, 110, 255)
	)
	makeNote(temple, "Recording", "Torn page", altar.Position + Vector3.new(-1.2, 1.6, 0))
	makePickup(temple, "Battery", "Battery", Vector3.new(20, 1, 318), Color3.fromRGB(120, 200, 255))

	makeStoryTrigger(temple, "Temple", CFrame.new(0, 4, 308), Vector3.new(46, 8, 8))
	makeCharacterSpot(temple, "Lira", Vector3.new(-14, 0.4, 322), Vector3.new(0, 0.4, 308), "Explore")
	-- Gate checkpoint is only unlocked once the puzzle is solved (see PuzzleService).
	makeCheckpoint(temple, "Temple", 2, Vector3.new(0, 0.4, 306))
	local escapeCheckpoint =
		makeZone(temple, "EscapeCheckpointSpawn", CFrame.new(0, 3.5, 352), Vector3.new(1, 1, 1), "EscapeSpawn")
	escapeCheckpoint:SetAttribute("SpawnPosition", Vector3.new(0, 3.5, 352))
	makeZone(temple, "StalkerHuntSpawn", CFrame.new(0, 4, 296), Vector3.new(1, 1, 1), "StalkerHuntSpawn")
end

local function buildEscape(level: Folder, rng: Random)
	local escape = Instance.new("Folder")
	escape.Name = "Escape"
	escape.Parent = level

	local rock = Color3.fromRGB(62, 58, 56)
	local mat = Enum.Material.Rock
	-- Tunnel from Z 361 to Z 430, 14 wide, 16 tall.
	makePart(escape, {
		Name = "TunnelFloor",
		Size = Vector3.new(16, 1, 70),
		Position = Vector3.new(0, -0.3, 396),
		Material = Enum.Material.Ground,
		Color = Color3.fromRGB(60, 52, 44),
	})
	makePart(escape, {
		Name = "TunnelWestWall",
		Size = Vector3.new(4, 16, 70),
		Position = Vector3.new(-9, 8, 396),
		Material = mat,
		Color = rock,
	})
	makePart(escape, {
		Name = "TunnelEastWall",
		Size = Vector3.new(4, 16, 70),
		Position = Vector3.new(9, 8, 396),
		Material = mat,
		Color = rock,
	})
	makePart(escape, {
		Name = "TunnelRoof",
		Size = Vector3.new(22, 4, 70),
		Position = Vector3.new(0, 18, 396),
		Material = mat,
		Color = rock,
	})
	-- A few support beams and fallen stones to weave around.
	for z = 372, 424, 13 do
		makePart(escape, {
			Name = "Beam",
			Size = Vector3.new(14, 1, 1),
			Position = Vector3.new(0, 14, z),
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(70, 52, 38),
		})
	end
	makeRock(escape, Vector3.new(-4, 1, 385), Vector3.new(4, 3, 5), rng)
	makeRock(escape, Vector3.new(4, 1, 405), Vector3.new(4, 3, 5), rng)
	makeRock(escape, Vector3.new(-3, 1, 420), Vector3.new(3, 2.5, 4), rng)
	-- Emergency glow strips so the route stays readable at full sprint.
	for z = 366, 428, 8 do
		local strip = makePart(escape, {
			Name = "GuideLight",
			Size = Vector3.new(0.4, 0.4, 2),
			Position = Vector3.new(-6.8, 0.4, z),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 120, 60),
			CanCollide = false,
		})
		addLight(strip, Color3.fromRGB(255, 110, 50), 10, 0.8)
	end

	makeZone(escape, "EscapeZone", CFrame.new(0, 8, 400), Vector3.new(18, 16, 80), "EscapeZone")

	-- Cliff area beyond the tunnel.
	local cliffColor = Color3.fromRGB(78, 74, 70)
	makePart(escape, {
		Name = "CliffBaseFloor",
		Size = Vector3.new(30, 1, 16),
		Position = Vector3.new(0, -0.3, 438),
		Material = Enum.Material.Ground,
		Color = Color3.fromRGB(60, 52, 44),
	})
	makePart(escape, {
		Name = "CliffSideWest",
		Size = Vector3.new(4, 40, 38),
		Position = Vector3.new(-15, 20, 442),
		Material = mat,
		Color = cliffColor,
	})
	makePart(escape, {
		Name = "CliffSideEast",
		Size = Vector3.new(4, 40, 38),
		Position = Vector3.new(15, 20, 442),
		Material = mat,
		Color = cliffColor,
	})
	makePart(escape, {
		Name = "Cliff",
		Size = Vector3.new(26, 24, 15),
		Position = Vector3.new(0, 12, 453.5),
		Material = mat,
		Color = cliffColor,
	})
	-- Seal the slots between the tunnel mouth and the cliff sides.
	makeWall(
		escape,
		Vector3.new(-17, 0, 430),
		Vector3.new(-9, 0, 430),
		30,
		2,
		Enum.Material.SmoothPlastic,
		Color3.new(),
		1
	)
	makeWall(
		escape,
		Vector3.new(9, 0, 430),
		Vector3.new(17, 0, 430),
		30,
		2,
		Enum.Material.SmoothPlastic,
		Color3.new(),
		1
	)
	-- Climbable truss ladder up the cliff face (Roblox characters climb trusses natively).
	local truss = Instance.new("TrussPart")
	truss.Name = "ClimbTruss"
	truss.Anchored = true
	truss.Size = Vector3.new(2, 26, 2)
	truss.Position = Vector3.new(0, 13, 445)
	truss.Material = Enum.Material.Wood
	truss.Color = Color3.fromRGB(96, 74, 52)
	truss.Parent = escape
	addLight(truss, Color3.fromRGB(255, 200, 140), 10, 0.6)

	makeStoryTrigger(escape, "Bridge", CFrame.new(0, 28, 456), Vector3.new(22, 8, 6))

	-- Rope bridge over the chasm (Z 461 to 510) at the cliff top height.
	local deckY = 24
	local plankCount = 0
	for z = 462, 509, 2 do
		plankCount += 1
		local plank = makePart(escape, {
			Name = "Plank" .. plankCount,
			Size = Vector3.new(7, 0.6, 1.8),
			CFrame = CFrame.new(0, deckY - 0.3, z) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-2, 2))),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(110, 84, 56),
		})
		plank:SetAttribute("HomeCFrame", plank.CFrame)
		CollectionService:AddTag(plank, "BridgePlank")
	end
	for _, x in { -3.6, 3.6 } do
		makePart(escape, {
			Name = "Rope",
			Size = Vector3.new(0.3, 0.3, 50),
			Position = Vector3.new(x, deckY + 2.5, 485.5),
			Material = Enum.Material.Fabric,
			Color = Color3.fromRGB(150, 130, 90),
		})
		-- Invisible rails stop accidental side falls (fairness over realism).
		makePart(escape, {
			Name = "SafetyRail",
			Size = Vector3.new(0.5, 6, 50),
			Position = Vector3.new(x * 1.05, deckY + 3, 485.5),
			Transparency = 1,
		})
	end

	-- Far landing with the rescue flare.
	makePart(escape, {
		Name = "FarLedge",
		Size = Vector3.new(30, 24, 37),
		Position = Vector3.new(0, 12, 527.5),
		Material = mat,
		Color = cliffColor,
	})
	local flare = makePart(escape, {
		Name = "RescueFlare",
		Size = Vector3.new(0.6, 3, 0.6),
		Position = Vector3.new(0, deckY + 1.5, 532),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 60, 60),
		CanCollide = false,
	})
	addLight(flare, Color3.fromRGB(255, 60, 60), 40, 3)
	local sparks = Instance.new("Fire")
	sparks.Color = Color3.fromRGB(255, 80, 60)
	sparks.SecondaryColor = Color3.fromRGB(255, 200, 120)
	sparks.Size = 3
	sparks.Parent = flare
	makeZone(escape, "EndZone", CFrame.new(0, deckY + 4, 528), Vector3.new(26, 8, 24), "EndZone")
	-- Kade and Lira wait at the flare once the escape begins.
	makeCharacterSpot(escape, "Kade", Vector3.new(-5, deckY, 524), Vector3.new(0, deckY, 505), "Escape")
	makeCharacterSpot(escape, "Lira", Vector3.new(5, deckY, 524), Vector3.new(0, deckY, 505), "Escape")

	-- Invisible walls around the cliff top and far ledge.
	local clear = Color3.new(0, 0, 0)
	makeWall(
		escape,
		Vector3.new(-14, deckY, 446),
		Vector3.new(-14, deckY, 461),
		20,
		1,
		Enum.Material.SmoothPlastic,
		clear,
		1
	)
	makeWall(
		escape,
		Vector3.new(14, deckY, 446),
		Vector3.new(14, deckY, 461),
		20,
		1,
		Enum.Material.SmoothPlastic,
		clear,
		1
	)
	makeWall(
		escape,
		Vector3.new(-15, deckY, 510),
		Vector3.new(-15, deckY, 546),
		20,
		1,
		Enum.Material.SmoothPlastic,
		clear,
		1
	)
	makeWall(
		escape,
		Vector3.new(15, deckY, 510),
		Vector3.new(15, deckY, 546),
		20,
		1,
		Enum.Material.SmoothPlastic,
		clear,
		1
	)
	makeWall(
		escape,
		Vector3.new(-15, deckY, 546),
		Vector3.new(15, deckY, 546),
		20,
		1,
		Enum.Material.SmoothPlastic,
		clear,
		1
	)

	-- Dark mist far below the bridge (falling in is fatal; see KillHeight).
	makePart(escape, {
		Name = "ChasmMist",
		Size = Vector3.new(80, 1, 60),
		Position = Vector3.new(0, -30, 486),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(10, 6, 14),
		Transparency = 0.2,
		CanCollide = false,
		CanQuery = false,
	})
end

-- Smooth terrain for the valley floor: real grass that sways, mud on the
-- trail and in the camp, plain ground under the paved and indoor areas.
-- Returns the terrain only on the build that should fill static shapes.
local function buildTerrain(): Terrain?
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	SceneryKit.Terrain = terrain
	if not terrain or terrainFilled then
		return nil
	end
	terrainFilled = true
	SceneryKit.FillValley(terrain, Random.new(7))
	for z = -10, 205, 6 do
		SceneryKit.PaintGround(terrain, Vector3.new(trailCenterX(z), 0, z), Vector2.new(8, 6), Enum.Material.Mud)
	end
	-- No grass blades poking through the courtyard, temple or tunnel floors.
	for _, area in { { 0, 257, 92, 88 }, { 0, 330, 54, 64 }, { 0, 400, 32, 92 } } do
		SceneryKit.PaintGround(
			terrain,
			Vector3.new(area[1], 0, area[2]),
			Vector2.new(area[3], area[4]),
			Enum.Material.Ground
		)
	end
	return terrain
end

-- Cliffs on both sides of the valley and the mountain to the north. All of
-- it is outside the playable area. Uses its own random seed so cliff-top
-- trees match the rock on every rebuild.
local function buildBackdrop(level: Folder, terrain: Terrain?)
	local rng = Random.new(99)
	local backdrop = Instance.new("Folder")
	backdrop.Name = "Backdrop"
	backdrop.Parent = level
	SceneryKit.CliffLine(backdrop, Vector3.new(-88, 0, -70), Vector3.new(-80, 0, 600), rng, terrain)
	SceneryKit.CliffLine(backdrop, Vector3.new(84, 0, -70), Vector3.new(92, 0, 600), rng, terrain)
	SceneryKit.CliffLine(backdrop, Vector3.new(-90, 0, -48), Vector3.new(90, 0, -48), rng, terrain)
	SceneryKit.Mountain(backdrop, Vector3.new(10, 0, 680), terrain)
end

------------------------------------------------------------------------------
-- Lighting
------------------------------------------------------------------------------

function LevelBuilder.SetupLighting()
	local L = Config.Lighting
	Lighting.ClockTime = L.ClockTime
	Lighting.Brightness = L.Brightness
	Lighting.ExposureCompensation = L.ExposureCompensation
	Lighting.Ambient = L.Ambient
	Lighting.OutdoorAmbient = L.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.3
	Lighting.GlobalShadows = true

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = L.FogDensity
	atmosphere.Offset = 0.05
	atmosphere.Color = Color3.fromRGB(80, 94, 96)
	atmosphere.Decay = Color3.fromRGB(46, 54, 62)
	atmosphere.Glare = 0
	atmosphere.Haze = L.FogHaze
	atmosphere.Parent = Lighting

	local grade = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	grade.Saturation = -0.15
	grade.Contrast = 0.08
	grade.Brightness = 0.03
	grade.TintColor = Color3.fromRGB(222, 238, 232)
	grade.Parent = Lighting

	-- Modern post-processing: soft glow on torches, headlights and neon,
	-- and a gentle depth haze on far scenery.
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local depth = Lighting:FindFirstChildOfClass("DepthOfFieldEffect") or Instance.new("DepthOfFieldEffect")
	depth.FarIntensity = 0.18
	depth.FocusDistance = 30
	depth.InFocusRadius = 60
	depth.NearIntensity = 0
	depth.Parent = Lighting

	-- Storm sky: no moon or stars behind the clouds.
	local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.CelestialBodiesShown = false
	sky.StarCount = 0
	sky.Parent = Lighting
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.85
		clouds.Density = 0.7
		clouds.Color = Color3.fromRGB(70, 78, 84)
		clouds.Parent = terrain
	end
end

------------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------------

-- Builds (or rebuilds) the level. The fixed random seed means every build
-- produces the same jungle layout.
function LevelBuilder.Build(): Folder
	if currentLevel then
		currentLevel:Destroy()
		currentLevel = nil
	end
	local rng = Random.new(1337)
	local level = Instance.new("Folder")
	level.Name = LEVEL_NAME
	local freshTerrain = buildTerrain()

	buildGroundAndBounds(level)
	buildJungle(level, rng)
	buildCrashSite(level, rng)
	buildTrail(level)
	buildCamp(level, rng)
	buildRuins(level, rng)
	buildTemple(level)
	buildEscape(level, rng)
	buildBackdrop(level, freshTerrain)

	-- Parent last: one replication burst instead of thousands of small ones.
	level.Parent = workspace
	currentLevel = level
	return level
end

-- Spawns a loose item pickup in the current level (used for dropped items).
function LevelBuilder.SpawnPickup(itemId: string, displayName: string, position: Vector3, color: Color3)
	local level = currentLevel
	if not level then
		return
	end
	local folder = level:FindFirstChild("Dropped")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Dropped"
		folder.Parent = level
	end
	makePickup(folder :: Instance, itemId, displayName, position, color)
end

function LevelBuilder.GetStartPosition(): Vector3
	return Vector3.new(0, 3.5, 2)
end

return LevelBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PuzzleService</string>
            <string name="Source"><![CDATA[--!strict
-- PuzzleService: the three stone dials in the temple.
--
-- Each dial cycles through four symbols. Setting them, left to right, to
-- EYE, MOON, SUN opens the sealed door. The clue is split between the mural
-- above the door (EYE ? SUN) and Rourke's journal in the camp.
--
-- The puzzle state lives on the server and is shared by all players. Once
-- solved it stays solved (dying cannot re-lock it), so it can never soft-lock.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)
local StoryService = require(script.Parent.StoryService)
local CheckpointService = require(script.Parent.CheckpointService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PuzzleService = {}

local SYMBOLS = {
	{ Name = "SUN", Color = Color3.fromRGB(255, 200, 80) },
	{ Name = "MOON", Color = Color3.fromRGB(170, 200, 255) },
	{ Name = "EYE", Color = Color3.fromRGB(255, 90, 90) },
	{ Name = "SPIRAL", Color = Color3.fromRGB(120, 230, 150) },
}
local SOLUTION = { 3, 2, 1 } -- EYE, MOON, SUN
local START_STATE = { 1, 4, 2 } -- SUN, SPIRAL, MOON (deliberately wrong)

local dialState: { number } = table.clone(START_STATE)
local solved = false
local lastTurn: { [number]: number } = {}

-- Called by Main when the puzzle is solved (starts the escape).
PuzzleService.OnSolved = nil :: (() -> ())?

local function refreshFaces()
	for _, face in CollectionService:GetTagged("PuzzleDialFace") do
		local index = face:GetAttribute("DialIndex")
		local label = face:FindFirstChild("SymbolLabel", true)
		if type(index) == "number" and label and label:IsA("TextLabel") then
			local symbol = SYMBOLS[dialState[index]]
			label.Text = symbol.Name
			label.TextColor3 = if solved then Color3.fromRGB(190, 110, 255) else symbol.Color
		end
	end
end

local function openGate()
	for _, gate in CollectionService:GetTagged("PuzzleGate") do
		if gate:IsA("BasePart") then
			local closed = gate:GetAttribute("ClosedPosition")
			if typeof(closed) == "Vector3" then
				local tween = TweenService:Create(
					gate,
					TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ Position = closed - Vector3.new(0, 14.5, 0) }
				)
				tween:Play()
			end
		end
	end
end

local function isSolved(): boolean
	for i, value in SOLUTION do
		if dialState[i] ~= value then
			return false
		end
	end
	return true
end

local function solve()
	solved = true
	refreshFaces()
	for _, dial in CollectionService:GetTagged("PuzzleDial") do
		local prompt = dial:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Enabled = false
		end
	end
	openGate()
	Remotes.CameraShake:FireAllClients(2.5, 0.6)
	StoryService.SetPhase("Escape")
	StoryService.SetObjective("Escape")
	StoryService.PlayDialogue("Solved")

	-- Everyone gets a checkpoint right by the door, so dying during the
	-- escape never means redoing the ruins.
	local marker = Zones.FirstTagged("EscapeSpawn")
	local spawnPos = marker and marker:GetAttribute("SpawnPosition")
	if typeof(spawnPos) == "Vector3" then
		for _, player in Players:GetPlayers() do
			CheckpointService.Set(player, 3, spawnPos, "Temple Door")
		end
	end
	if PuzzleService.OnSolved then
		PuzzleService.OnSolved()
	end
end

local function bindDial(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local dial = inst
	local prompt = dial:FindFirstChildOfClass("ProximityPrompt")
	local index = dial:GetAttribute("DialIndex")
	if not prompt or type(index) ~= "number" then
		return
	end
	prompt.Enabled = not solved
	prompt.Triggered:Connect(function(player)
		if solved then
			return
		end
		local _, _, root = PlayerData.GetAliveCharacter(player)
		if not root or (root.Position - dial.Position).Magnitude > 14 then
			return
		end
		-- Small per-dial debounce so simultaneous presses do not double-turn.
		local now = os.clock()
		if lastTurn[index] and now - lastTurn[index] < 0.3 then
			return
		end
		lastTurn[index] = now
		dialState[index] = dialState[index] % #SYMBOLS + 1
		refreshFaces()
		if isSolved() then
			solve()
		end
	end)
	refreshFaces()
end

function PuzzleService.IsSolved(): boolean
	return solved
end

function PuzzleService.Reset()
	dialState = table.clone(START_STATE)
	solved = false
	table.clear(lastTurn)
	for _, dial in CollectionService:GetTagged("PuzzleDial") do
		local prompt = dial:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Enabled = true
		end
	end
	refreshFaces()
end

function PuzzleService.Init()
	Zones.BindTag("PuzzleDial", bindDial)
	Zones.BindTag("PuzzleDialFace", function()
		refreshFaces()
	end)
end

return PuzzleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">StalkerService</string>
            <string name="Source"><![CDATA[--!strict
-- StalkerService: the Rift Stalker, the demo's one active enemy.
--
-- It runs a simple state machine on the server, a few times per second:
--
--   Patrol      walks a loop of patrol points in the ruins
--   Investigate heard a noise: walks to where it came from and looks around
--   Chase       sees a player: runs at them
--   Attack      close enough: winds up (a visible tell) and then swings
--   Search      lost sight: checks the last known position, then wanders
--   Return      gives up and walks back to its patrol route
--   Hunt        scripted escape sequence: pursues the nearest escaping player
--   Idle        waits (before being released during the escape)
--
-- Fair-horror rules: it only knows where you are if it SEES you (in front of
-- it, within range, with nothing blocking the view) or HEARS you (sprinting
-- is loud, walking is quiet, crouching is nearly silent). Crouching inside
-- tall grass hides you unless it is right next to you. A lit flashlight lets
-- it see you from further away.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C = Config.Stalker

local StalkerService = {}

type State = "Patrol" | "Investigate" | "Chase" | "Attack" | "Search" | "Return" | "Hunt" | "Idle"

local model: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local eyes: { BasePart } = {}

local state: State = "Patrol"
local stateStarted = 0
local mode: "Explore" | "Hunt" = "Explore"
local huntReleaseTime = 0

local target: Player? = nil
local lastSeenTime = 0
local lastKnownPosition: Vector3? = nil
local investigatePosition: Vector3? = nil
local searchPoint: Vector3? = nil
local lastAttackTime = 0
local attackStarted = 0

local patrolPoints: { Vector3 } = {}
local patrolIndex = 1

-- Pathfinding bookkeeping.
local path = PathfindingService:CreatePath({
	AgentRadius = 2.5,
	AgentHeight = 9,
	AgentCanJump = false,
	AgentCanClimb = false,
	WaypointSpacing = 6,
})
local waypoints: { PathWaypoint } = {}
local waypointIndex = 1
local pathGoal: Vector3? = nil
local lastPathTime = 0
local pathFailures = 0
local lastProgressPosition = Vector3.zero
local lastProgressTime = 0

local rng = Random.new()

local MODEL_NAME = "RiftStalker"
local EYE_COLOR = Color3.fromRGB(255, 90, 230)
local ATTACK_EYE_COLOR = Color3.fromRGB(255, 30, 30)

------------------------------------------------------------------------------
-- Model
------------------------------------------------------------------------------

-- Builds a tall, thin placeholder creature from parts. Replace with a real
-- model later (keep a Humanoid and a HumanoidRootPart).
local function buildModel(position: Vector3): Model
	local m = Instance.new("Model")
	m.Name = MODEL_NAME
	local body = Color3.fromRGB(34, 24, 46)

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.CFrame = CFrame.new(position)
	hrp.Parent = m

	local function limb(name: string, size: Vector3, offset: CFrame, color: Color3?, material: Enum.Material?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = hrp.CFrame * offset
		p.Color = color or body
		p.Material = material or Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = true
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = m
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hrp
		weld.Part1 = p
		weld.Parent = p
		return p
	end

	-- The Rift Stalker (concept sheet): a tall alien hunter with a dark
	-- violet exoskeleton, glowing crystal spines, long clawed arms and
	-- back-bent legs. Fast, aggressive, and able to phase between dimensions.
	local shell = Color3.fromRGB(34, 24, 46)
	local plate = Color3.fromRGB(58, 40, 78)
	local crystal = Color3.fromRGB(190, 90, 255)

	local torso =
		limb("Torso", Vector3.new(2.0, 3.0, 1.1), CFrame.new(0, 1.9, 0) * CFrame.Angles(math.rad(-14), 0, 0), shell)
	-- The torso is the one part that collides, so players cannot walk through it.
	torso.CanCollide = true
	limb(
		"Chest",
		Vector3.new(2.3, 1.3, 1.3),
		CFrame.new(0, 2.8, -0.25) * CFrame.Angles(math.rad(-14), 0, 0),
		plate,
		Enum.Material.Slate
	)
	limb("Waist", Vector3.new(1.3, 0.9, 0.9), CFrame.new(0, 0.2, 0), shell)
	limb("Neck", Vector3.new(0.6, 0.9, 0.6), CFrame.new(0, 3.9, -0.55) * CFrame.Angles(math.rad(-30), 0, 0), shell)
	limb(
		"Head",
		Vector3.new(1.1, 1.0, 1.7),
		CFrame.new(0, 4.5, -0.95) * CFrame.Angles(math.rad(-8), 0, 0),
		plate,
		Enum.Material.Slate
	)
	limb("Jaw", Vector3.new(0.9, 0.35, 1.2), CFrame.new(0, 4.05, -1.15) * CFrame.Angles(math.rad(10), 0, 0), shell)

	-- Long arms: upper arm, forearm, and three claws each.
	for _, side in { -1, 1 } do
		limb(
			"UpperArm",
			Vector3.new(0.5, 2.6, 0.5),
			CFrame.new(side * 1.4, 2.3, -0.2) * CFrame.Angles(math.rad(-15), 0, math.rad(side * 12)),
			shell
		)
		limb(
			"Forearm",
			Vector3.new(0.42, 2.8, 0.42),
			CFrame.new(side * 1.75, 0.0, -0.75) * CFrame.Angles(math.rad(-30), 0, math.rad(side * 4)),
			plate
		)
		for c = -1, 1 do
			local claw = limb(
				"Claw",
				Vector3.new(0.12, 1.1, 0.12),
				CFrame.new(side * 1.85 + c * 0.14, -1.55, -1.45) * CFrame.Angles(math.rad(-40), 0, math.rad(c * 10)),
				Color3.fromRGB(220, 200, 240),
				Enum.Material.Marble
			)
			claw.CanQuery = false
		end
		-- Back-bent legs: thigh forward, shin back, foot.
		limb(
			"Thigh",
			Vector3.new(0.7, 2.0, 0.7),
			CFrame.new(side * 0.6, -0.9, -0.35) * CFrame.Angles(math.rad(25), 0, 0),
			shell
		)
		limb(
			"Shin",
			Vector3.new(0.5, 2.2, 0.5),
			CFrame.new(side * 0.6, -2.7, 0.15) * CFrame.Angles(math.rad(-20), 0, 0),
			plate
		)
		limb("Foot", Vector3.new(0.6, 0.3, 1.2), CFrame.new(side * 0.6, -3.85, -0.2), shell)
	end

	-- Glowing crystal spines along the back, shoulders and head crest.
	local spines = {
		{ Vector3.new(0, 3.3, 0.7), -35, 0, 1.6 },
		{ Vector3.new(0, 2.5, 0.75), -45, 0, 1.3 },
		{ Vector3.new(0, 1.7, 0.7), -55, 0, 1.0 },
		{ Vector3.new(-1.1, 3.3, 0.2), -20, -35, 1.2 },
		{ Vector3.new(1.1, 3.3, 0.2), -20, 35, 1.2 },
		{ Vector3.new(0, 5.0, -0.6), -60, 0, 1.0 },
		{ Vector3.new(-0.3, 4.9, -0.4), -55, -20, 0.8 },
		{ Vector3.new(0.3, 4.9, -0.4), -55, 20, 0.8 },
	}
	for i, spine in spines do
		local length = spine[4] :: number
		local part = limb(
			"Crystal" .. i,
			Vector3.new(0.22, length, 0.22),
			CFrame.new(spine[1] :: Vector3)
				* CFrame.Angles(math.rad(spine[2] :: number), 0, math.rad(spine[3] :: number))
				* CFrame.new(0, length / 2, 0),
			crystal,
			Enum.Material.Neon
		)
		part.CanQuery = false
	end
	-- Glowing seams down the chest.
	for _, x in { -0.45, 0.45 } do
		local seam = limb(
			"Seam",
			Vector3.new(0.08, 1.6, 0.08),
			CFrame.new(x, 2.2, -0.95) * CFrame.Angles(math.rad(-14), 0, 0),
			crystal,
			Enum.Material.Neon
		)
		seam.CanQuery = false
	end
	local core = limb("Core", Vector3.new(0.4, 0.4, 0.2), CFrame.new(0, 2.9, -0.95), crystal, Enum.Material.Neon)
	core.CanQuery = false
	local aura = Instance.new("PointLight")
	aura.Color = crystal
	aura.Range = 12
	aura.Brightness = 1.4
	aura.Parent = core

	table.clear(eyes)
	for _, x in { -0.3, 0.3 } do
		local eye = limb("Eye", Vector3.new(0.25, 0.14, 0.1), CFrame.new(x, 4.6, -1.8), EYE_COLOR, Enum.Material.Neon)
		eye.CanQuery = false
		table.insert(eyes, eye)
	end
	local glow = Instance.new("PointLight")
	glow.Color = EYE_COLOR
	glow.Range = 8
	glow.Brightness = 1.2
	glow.Parent = eyes[1]

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 3 -- Root bottom (Y -1) to feet (Y -4).
	hum.MaxHealth = C.MaxHealth
	hum.Health = C.MaxHealth
	hum.WalkSpeed = C.PatrolSpeed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.Parent = m

	m.PrimaryPart = hrp
	return m
end

------------------------------------------------------------------------------
-- Movement
------------------------------------------------------------------------------

local function clearPath()
	table.clear(waypoints)
	waypointIndex = 1
	pathGoal = nil
end

local function stopMoving()
	if humanoid and root then
		humanoid:MoveTo(root.Position)
	end
	clearPath()
end

local function setSpeed(speed: number)
	if humanoid then
		humanoid.WalkSpeed = speed
	end
end

local function lineOfSightClear(from: Vector3, to: Vector3, ignore: { Instance }): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return workspace:Raycast(from, to - from, params) == nil
end

local function characterList(): { Instance }
	local list: { Instance } = {}
	if model then
		table.insert(list, model)
	end
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	return list
end

-- Moves toward `goal` using pathfinding, re-planning when the goal moves or
-- the current plan goes stale. Returns false if it could not make progress.
local function moveToward(goal: Vector3): boolean
	if not humanoid or not root then
		return false
	end
	local now = os.clock()
	local needsPath = pathGoal == nil
		or (goal - (pathGoal :: Vector3)).Magnitude > 4
		or now - lastPathTime > C.RepathInterval * 3
		or waypointIndex > #waypoints

	if needsPath and now - lastPathTime >= C.RepathInterval then
		lastPathTime = now
		local ok = pcall(function()
			path:ComputeAsync(root.Position, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			waypoints = path:GetWaypoints()
			waypointIndex = math.min(2, #waypoints)
			pathGoal = goal
			pathFailures = 0
		else
			pathFailures += 1
			clearPath()
			-- Fallback: if nothing blocks the way, walk straight there.
			if lineOfSightClear(root.Position, goal, characterList()) then
				humanoid:MoveTo(goal)
				return true
			end
			return pathFailures < 4
		end
	end

	local waypoint = waypoints[waypointIndex]
	if waypoint then
		local flat = Vector3.new(waypoint.Position.X - root.Position.X, 0, waypoint.Position.Z - root.Position.Z)
		if flat.Magnitude < 3 then
			waypointIndex += 1
			waypoint = waypoints[waypointIndex]
		end
	end
	if waypoint then
		humanoid:MoveTo(waypoint.Position)
	else
		humanoid:MoveTo(goal)
	end

	-- Stuck detection: no real progress for a while means re-plan.
	if (root.Position - lastProgressPosition).Magnitude > 1.5 then
		lastProgressPosition = root.Position
		lastProgressTime = now
	elseif now - lastProgressTime > 2.5 then
		lastProgressTime = now
		clearPath()
		pathFailures += 1
		return pathFailures < 4
	end
	return true
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

------------------------------------------------------------------------------
-- Senses
------------------------------------------------------------------------------

local function isHidden(player: Player, position: Vector3): boolean
	return player:GetAttribute("Crouching") == true and Zones.InAnyTagged("HidingSpot", position)
end

local function canSee(player: Player, targetRoot: BasePart): boolean
	if not root or not model then
		return false
	end
	local eyePos = root.Position + Vector3.new(0, 4.3, 0)
	local toTarget = targetRoot.Position - root.Position
	local distance = toTarget.Magnitude
	if distance < 1 then
		return true
	end
	local range = if player:GetAttribute("FlashlightOn") then C.SightRangeFlashlightOn else C.SightRange
	if distance > range then
		return false
	end
	if isHidden(player, targetRoot.Position) and distance > C.HidingRevealDistance then
		return false
	end
	-- View cone (always notices players brushing right past it).
	local look = root.CFrame.LookVector
	local flatDir = Vector3.new(toTarget.X, 0, toTarget.Z).Unit
	local flatLook = Vector3.new(look.X, 0, look.Z).Unit
	if distance > 6 and flatLook:Dot(flatDir) < math.cos(math.rad(C.SightHalfAngle)) then
		return false
	end
	return lineOfSightClear(eyePos, targetRoot.Position + Vector3.new(0, 1.5, 0), characterList())
end

local function noiseRadius(player: Player, targetRoot: BasePart): number
	local velocity = targetRoot.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	if speed < 2 then
		return 0
	elseif player:GetAttribute("Crouching") then
		return C.HearingCrouch
	elseif speed > Config.Player.WalkSpeed + 2 then
		return C.HearingSprint
	end
	return C.HearingWalk
end

-- Finds the closest visible player, and the closest heard noise.
local function sense(): (Player?, BasePart?, Vector3?)
	if not root then
		return nil, nil, nil
	end
	local seenPlayer: Player?, seenRoot: BasePart?, seenDistance = nil, nil, math.huge
	local heardPosition: Vector3?, heardDistance = nil, math.huge
	for _, player in Players:GetPlayers() do
		local data = PlayerData.Get(player)
		local _, _, playerRoot = PlayerData.GetAliveCharacter(player)
		if not playerRoot or (data and data.Finished) then
			continue
		end
		local distance = (playerRoot.Position - root.Position).Magnitude
		if distance < seenDistance and canSee(player, playerRoot) then
			seenPlayer, seenRoot, seenDistance = player, playerRoot, distance
		end
		if distance <= noiseRadius(player, playerRoot) and distance < heardDistance then
			heardPosition, heardDistance = playerRoot.Position, distance
		end
	end
	return seenPlayer, seenRoot, heardPosition
end

------------------------------------------------------------------------------
-- State machine
------------------------------------------------------------------------------

local function setState(newState: State)
	if state == newState then
		return
	end
	state = newState
	stateStarted = os.clock()
	clearPath()
	if model then
		model:SetAttribute("State", newState) -- Visible in Studio for debugging.
	end
	if newState == "Patrol" or newState == "Return" then
		setSpeed(C.PatrolSpeed)
	elseif newState == "Investigate" or newState == "Search" then
		setSpeed(C.InvestigateSpeed)
	elseif newState == "Chase" then
		setSpeed(C.ChaseSpeed)
	elseif newState == "Hunt" then
		setSpeed(C.HuntSpeed)
	end
end

local function setEyesBright(bright: boolean)
	for _, eye in eyes do
		eye.Color = if bright then ATTACK_EYE_COLOR else EYE_COLOR
	end
end

local function nearestPatrolIndex(): number
	if not root then
		return 1
	end
	local best, bestDistance = 1, math.huge
	for i, point in patrolPoints do
		local d = (point - root.Position).Magnitude
		if d < bestDistance then
			best, bestDistance = i, d
		end
	end
	return best
end

local function currentTargetRoot(): BasePart?
	if not target then
		return nil
	end
	local data = PlayerData.Get(target)
	local _, _, targetRoot = PlayerData.GetAliveCharacter(target)
	if data and data.Finished then
		return nil
	end
	return targetRoot
end

-- Starts an attack; the damage is decided when the wind-up ends.
local function beginAttack()
	setState("Attack")
	attackStarted = os.clock()
	stopMoving()
	setEyesBright(true)
end

local function updateAttack(returnState: State)
	local targetRoot = currentTargetRoot()
	if not target or not targetRoot or not root then
		setEyesBright(false)
		setState(returnState)
		return
	end
	-- Turn to face the target during the wind-up.
	root.CFrame =
		CFrame.lookAt(root.Position, Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z))
	if os.clock() - attackStarted < C.AttackWindup then
		return
	end
	-- Only hits if the player is still in reach: dodging the tell works.
	if flatDistance(targetRoot.Position, root.Position) <= C.AttackRange + 1 then
		local _, targetHumanoid = PlayerData.GetAliveCharacter(target)
		if targetHumanoid then
			targetHumanoid:TakeDamage(C.AttackDamage)
			Remotes.CameraShake:FireClient(target, 0.4, 1.2)
		end
	end
	lastAttackTime = os.clock()
	setEyesBright(false)
	setState(returnState)
end

local function tickExplore()
	if not root then
		return
	end
	local now = os.clock()
	local seenPlayer, seenRoot, heardPosition = sense()

	if state == "Attack" then
		updateAttack("Chase")
		return
	end

	if seenPlayer and seenRoot then
		target = seenPlayer
		lastSeenTime = now
		lastKnownPosition = seenRoot.Position
		if state ~= "Chase" then
			setState("Chase")
		end
	elseif
		heardPosition and (state == "Patrol" or state == "Return" or state == "Search" or state == "Investigate")
	then
		if state ~= "Investigate" or (investigatePosition and (heardPosition - investigatePosition).Magnitude > 8) then
			investigatePosition = heardPosition
			setState("Investigate")
		end
	end

	if state == "Patrol" then
		if #patrolPoints == 0 then
			return
		end
		local point = patrolPoints[patrolIndex]
		if flatDistance(point, root.Position) < 4 then
			patrolIndex = patrolIndex % #patrolPoints + 1
			point = patrolPoints[patrolIndex]
		end
		if not moveToward(point) then
			patrolIndex = patrolIndex % #patrolPoints + 1
			pathFailures = 0
		end
	elseif state == "Investigate" then
		local goal = investigatePosition
		if not goal then
			setState("Return")
			return
		end
		if flatDistance(goal, root.Position) < 5 or not moveToward(goal) then
			-- Arrived (or cannot reach): pause and "listen".
			stopMoving()
			if now - stateStarted > C.InvestigateTime then
				setState("Return")
			end
		elseif now - stateStarted > C.InvestigateTime * 3 then
			setState("Return")
		end
	elseif state == "Chase" then
		local targetRoot = currentTargetRoot()
		if not targetRoot then
			target = nil
			setState("Return")
			return
		end
		if now - lastSeenTime > C.LoseSightTime then
			searchPoint = lastKnownPosition
			setState("Search")
			return
		end
		if
			now - lastSeenTime < 0.3
			and flatDistance(targetRoot.Position, root.Position) <= C.AttackRange
			and now - lastAttackTime > C.AttackCooldown
		then
			beginAttack()
			return
		end
		-- Chase toward where it last saw the player, not where they truly are.
		if not moveToward(lastKnownPosition or targetRoot.Position) then
			searchPoint = lastKnownPosition
			setState("Search")
		end
	elseif state == "Search" then
		if now - stateStarted > C.SearchTime then
			target = nil
			setState("Return")
			return
		end
		local goal = searchPoint
		if not goal or flatDistance(goal, root.Position) < 4 then
			local base = lastKnownPosition or root.Position
			searchPoint = base + Vector3.new(rng:NextNumber(-14, 14), 0, rng:NextNumber(-14, 14))
			return
		end
		if not moveToward(goal) then
			searchPoint = nil
		end
	elseif state == "Return" then
		patrolIndex = nearestPatrolIndex()
		setState("Patrol")
	end
end

-- During the escape the creature ignores stealth and pursues whoever is
-- still running through the collapsing temple.
local function tickHunt()
	if not root then
		return
	end
	local now = os.clock()
	if now < huntReleaseTime then
		setState("Idle")
		stopMoving()
		return
	end
	if state == "Attack" then
		updateAttack("Hunt")
		return
	end
	local best: Player?, bestRoot: BasePart?, bestDistance = nil, nil, math.huge
	for _, player in Players:GetPlayers() do
		local data = PlayerData.Get(player)
		local _, _, playerRoot = PlayerData.GetAliveCharacter(player)
		if playerRoot and not (data and data.Finished) then
			local pos = playerRoot.Position
			-- Only players still on the escape route (not up the cliff).
			if pos.Z > 285 and pos.Z < 447 and pos.Y < 18 then
				local d = (pos - root.Position).Magnitude
				if d < bestDistance then
					best, bestRoot, bestDistance = player, playerRoot, d
				end
			end
		end
	end
	if not best or not bestRoot then
		setState("Idle")
		stopMoving()
		return
	end
	target = best
	setState("Hunt")
	if flatDistance(bestRoot.Position, root.Position) <= C.AttackRange and now - lastAttackTime > C.AttackCooldown then
		beginAttack()
		return
	end
	moveToward(bestRoot.Position)
end

------------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------------

local function loadPatrolPoints()
	local markers = CollectionService:GetTagged("StalkerPatrol")
	table.sort(markers, function(a, b)
		return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
	end)
	table.clear(patrolPoints)
	for _, marker in markers do
		if marker:IsA("BasePart") and marker:IsDescendantOf(workspace) then
			table.insert(patrolPoints, marker.Position)
		end
	end
	patrolIndex = 1
end

function StalkerService.Despawn()
	if model then
		model:Destroy()
	end
	model, humanoid, root = nil, nil, nil
	table.clear(eyes)
	clearPath()
	target = nil
end

local function spawnAt(position: Vector3)
	StalkerService.Despawn()
	local m = buildModel(position)
	m.Parent = workspace
	model = m
	humanoid = m:FindFirstChildOfClass("Humanoid")
	local hrp = m.PrimaryPart
	root = hrp
	if hrp then
		-- The server simulates the creature, so clients cannot move it.
		pcall(function()
			hrp:SetNetworkOwner(nil)
		end)
	end
	lastProgressPosition = position
	lastProgressTime = os.clock()
end

-- Spawns the creature on its patrol in the ruins (start of a run).
function StalkerService.SpawnPatrol()
	loadPatrolPoints()
	local marker = Zones.FirstTagged("StalkerSpawn")
	spawnAt(if marker then marker.Position else Vector3.new(0, 4, 292))
	mode = "Explore"
	state = "Idle"
	setState("Patrol")
end

-- Starts the escape chase: the creature appears at the temple entrance and
-- is released after a short delay, giving players a head start.
function StalkerService.StartHunt(delaySeconds: number)
	local marker = Zones.FirstTagged("StalkerHuntSpawn")
	spawnAt(if marker then marker.Position else Vector3.new(0, 4, 296))
	mode = "Hunt"
	huntReleaseTime = os.clock() + delaySeconds
	state = "Patrol"
	setState("Idle")
end

function StalkerService.GetMode(): string
	return mode
end

-- Every few seconds the creature briefly flickers, half out of this
-- dimension. Purely visual; it never happens during an attack wind-up, so
-- the attack tell stays readable.
local function phaseFlicker()
	local m = model
	if not m or state == "Attack" then
		return
	end
	for _ = 1, 2 do
		for _, part in m:GetDescendants() do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.Transparency = 0.7
			end
		end
		task.wait(0.12)
		for _, part in m:GetDescendants() do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.Transparency = 0
			end
		end
		task.wait(0.1)
	end
end

function StalkerService.Init()
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(5, 9))
			if model and model.Parent then
				phaseFlicker()
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(C.TickInterval)
			if model and root and humanoid and model.Parent then
				local ok, err = pcall(if mode == "Hunt" then tickHunt else tickExplore)
				if not ok then
					warn("[StalkerService] AI tick failed:", err)
				end
			end
		end
	end)
end

return StalkerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">StoryService</string>
            <string name="Source"><![CDATA[--!strict
-- StoryService: objectives, radio dialogue, on-screen messages, and the
-- one-time story trigger zones placed around the map.
--
-- The current objective is stored as an attribute on ReplicatedStorage, so
-- players who join late automatically see the right objective.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Story = require(ReplicatedStorage.Shared.Story)
local Zones = require(script.Parent.Parent.Util.Zones)
local PlayerData = require(script.Parent.Parent.Util.PlayerData)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local StoryService = {}

-- Objectives only ever move forward, in this order.
local OBJECTIVE_ORDER = { "Start", "Camp", "Ruins", "Puzzle", "Escape", "Bridge", "Done" }

local currentObjectiveIndex = 0
local firedTriggers: { [string]: boolean } = {}

-- Phase gates: some triggers only make sense during a particular phase.
local triggerRequiresPhase: { [string]: string } = {
	Bridge = "Escape",
}

function StoryService.GetPhase(): string
	return ReplicatedStorage:GetAttribute("Phase") or "Explore"
end

function StoryService.SetPhase(phase: string)
	ReplicatedStorage:SetAttribute("Phase", phase)
end

function StoryService.SetObjective(key: string)
	local index = table.find(OBJECTIVE_ORDER, key)
	if not index or index <= currentObjectiveIndex then
		return
	end
	currentObjectiveIndex = index
	ReplicatedStorage:SetAttribute("Objective", (Story.Objectives :: any)[key])
	Remotes.Toast:FireAllClients("New objective", "objective")
end

-- Sends a dialogue sequence to one player, or to everyone if player is nil.
function StoryService.PlayDialogue(key: string, player: Player?)
	local lines = (Story.Dialogue :: any)[key]
	if not lines then
		warn("[StoryService] Unknown dialogue key:", key)
		return
	end
	if player then
		Remotes.Dialogue:FireClient(player, lines)
	else
		Remotes.Dialogue:FireAllClients(lines)
	end
end

function StoryService.Toast(player: Player, text: string, kind: string?)
	Remotes.Toast:FireClient(player, text, kind or "info")
end

local function onTrigger(triggerId: string)
	if triggerId == "ClawMarks" then
		StoryService.PlayDialogue("ClawMarks")
	elseif triggerId == "Camp" then
		StoryService.SetObjective("Camp")
		StoryService.PlayDialogue("Camp")
	elseif triggerId == "Ruins" then
		StoryService.SetObjective("Ruins")
		StoryService.PlayDialogue("Ruins")
	elseif triggerId == "Temple" then
		StoryService.SetObjective("Puzzle")
		StoryService.PlayDialogue("Temple")
	elseif triggerId == "Bridge" then
		StoryService.SetObjective("Bridge")
		StoryService.PlayDialogue("Bridge")
	end
end

-- Resets story progress for a fresh run (Play Again).
function StoryService.Reset()
	currentObjectiveIndex = 0
	table.clear(firedTriggers)
	StoryService.SetPhase("Explore")
	StoryService.SetObjective("Start")
end

function StoryService.Init()
	StoryService.Reset()

	-- Each new player hears the intro on their first spawn.
	local function onPlayerAdded(player: Player)
		local function playIntro()
			task.wait(2)
			if player.Parent then
				StoryService.PlayDialogue("Intro", player)
			end
		end
		if player.Character then
			task.spawn(playIntro)
		else
			player.CharacterAdded:Once(playIntro)
		end
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	-- Poll story trigger zones a few times per second (cheap with few zones).
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, zone in CollectionService:GetTagged("StoryTrigger") do
				if not zone:IsA("BasePart") then
					continue
				end
				local id = zone:GetAttribute("TriggerId")
				if type(id) ~= "string" or firedTriggers[id] then
					continue
				end
				local phase = triggerRequiresPhase[id]
				if phase and StoryService.GetPhase() ~= phase then
					continue
				end
				for _, player in Players:GetPlayers() do
					local _, _, root = PlayerData.GetAliveCharacter(player)
					if root and Zones.Contains(zone, root.Position) then
						firedTriggers[id] = true
						onTrigger(id)
						break
					end
				end
			end
		end
	end)
end

return StoryService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Outfitter</string>
            <string name="Source"><![CDATA[--!strict
-- Outfitter: dresses an R15 body (a player's character or an NPC rig) to
-- match a design from Shared/CharacterDesigns: skin and clothing colours,
-- a hairstyle, a drawn face, and gear pieces built from parts.
--
-- Everything added is named "Outfit_*" (or is the "OutfitFace" gui), so
-- Outfitter.Clear can remove it before a different outfit is applied.
--
-- Orientation reminder: on every R15 body part, -Z is the front and +Z the
-- back, +Y is up.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterDesigns = require(ReplicatedStorage.Shared.CharacterDesigns)

type Design = CharacterDesigns.Design

local Outfitter = {}

local PREFIX = "Outfit_"

-- Which design colour each body part takes.
local BODY_COLORS: { [string]: string } = {
	Head = "Skin",
	UpperTorso = "Jacket",
	LowerTorso = "Trousers",
	LeftUpperArm = "Sleeves",
	RightUpperArm = "Sleeves",
	LeftLowerArm = "Sleeves",
	RightLowerArm = "Sleeves",
	LeftHand = "Gloves",
	RightHand = "Gloves",
	LeftUpperLeg = "Trousers",
	RightUpperLeg = "Trousers",
	LeftLowerLeg = "Trousers",
	RightLowerLeg = "Trousers",
	LeftFoot = "Boots",
	RightFoot = "Boots",
}

type Ctx = {
	Model: Model,
	Design: Design,
	Parts: { [string]: BasePart },
}

-- Welds a part to `body` at `offset` (relative to the body part's CFrame).
local function add(ctx: Ctx, bodyName: string, name: string, props: { [string]: any }, offset: CFrame): Part?
	local body = ctx.Parts[bodyName]
	if not body then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = PREFIX .. name
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Fabric
	-- Head pieces never shadow the head-mounted flashlight.
	p.CastShadow = bodyName ~= "Head"
	for key, value in props do
		(p :: any)[key] = value
	end
	p.CFrame = body.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = p
	weld.Parent = p
	p.Parent = ctx.Model
	return p
end

local function glow(part: Part?, color: Color3, range: number, brightness: number)
	if not part then
		return
	end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = part
end

local function size(ctx: Ctx, bodyName: string): Vector3
	local body = ctx.Parts[bodyName]
	return if body then body.Size else Vector3.one
end

local function darker(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

------------------------------------------------------------------------------
-- Hair and face
------------------------------------------------------------------------------

local function hairPiece(ctx: Ctx, name: string, partSize: Vector3, offset: CFrame)
	add(ctx, "Head", "Hair" .. name, {
		Size = partSize,
		Color = ctx.Design.Hair,
		Material = Enum.Material.SmoothPlastic,
	}, offset)
end

local HAIR_BUILDERS: { [string]: (Ctx, Vector3) -> () } = {
	Messy = function(ctx, hs)
		hairPiece(ctx, "Cap", Vector3.new(hs.X * 1.06, hs.Y * 0.3, hs.Z * 1.06), CFrame.new(0, hs.Y * 0.4, 0.02))
		hairPiece(
			ctx,
			"Back",
			Vector3.new(hs.X * 1.04, hs.Y * 0.6, hs.Z * 0.25),
			CFrame.new(0, hs.Y * 0.1, hs.Z * 0.42)
		)
		hairPiece(
			ctx,
			"Fringe",
			Vector3.new(hs.X * 0.95, hs.Y * 0.22, hs.Z * 0.18),
			CFrame.new(-hs.X * 0.05, hs.Y * 0.28, -hs.Z * 0.48) * CFrame.Angles(0, 0, math.rad(-8))
		)
		-- Tousled tufts on top.
		local tufts = {
			{ -0.3, 0.1, -0.25, 25 },
			{ 0.05, 0.15, -0.3, -15 },
			{ 0.3, 0.08, -0.15, 30 },
			{ -0.2, 0.12, 0.15, -25 },
			{ 0.2, 0.1, 0.2, 15 },
		}
		for i, t in tufts do
			hairPiece(
				ctx,
				"Tuft" .. i,
				Vector3.new(hs.X * 0.32, hs.Y * 0.22, hs.Z * 0.32),
				CFrame.new(t[1] * hs.X, hs.Y * (0.5 + t[2]), t[3] * hs.Z)
					* CFrame.Angles(math.rad(t[4]), math.rad(t[4] * 2), math.rad(t[4]))
			)
		end
		for _, side in { -1, 1 } do
			hairPiece(
				ctx,
				"Side",
				Vector3.new(hs.X * 0.12, hs.Y * 0.4, hs.Z * 0.7),
				CFrame.new(side * hs.X * 0.5, hs.Y * 0.18, 0.05)
			)
		end
	end,
	Short = function(ctx, hs)
		hairPiece(ctx, "Cap", Vector3.new(hs.X * 1.04, hs.Y * 0.18, hs.Z * 1.04), CFrame.new(0, hs.Y * 0.44, 0.02))
		hairPiece(
			ctx,
			"Back",
			Vector3.new(hs.X * 1.03, hs.Y * 0.45, hs.Z * 0.2),
			CFrame.new(0, hs.Y * 0.18, hs.Z * 0.43)
		)
		for _, side in { -1, 1 } do
			hairPiece(
				ctx,
				"Side",
				Vector3.new(hs.X * 0.1, hs.Y * 0.35, hs.Z * 0.75),
				CFrame.new(side * hs.X * 0.5, hs.Y * 0.22, 0.05)
			)
		end
	end,
	Bob = function(ctx, hs)
		hairPiece(ctx, "Cap", Vector3.new(hs.X * 1.08, hs.Y * 0.3, hs.Z * 1.08), CFrame.new(0, hs.Y * 0.4, 0.02))
		hairPiece(
			ctx,
			"Back",
			Vector3.new(hs.X * 1.08, hs.Y * 0.95, hs.Z * 0.28),
			CFrame.new(0, -hs.Y * 0.02, hs.Z * 0.42)
		)
		for _, side in { -1, 1 } do
			hairPiece(
				ctx,
				"Side",
				Vector3.new(hs.X * 0.16, hs.Y * 0.9, hs.Z * 0.95),
				CFrame.new(side * hs.X * 0.52, -hs.Y * 0.02, 0.04)
			)
		end
		hairPiece(
			ctx,
			"Fringe",
			Vector3.new(hs.X * 1.0, hs.Y * 0.2, hs.Z * 0.16),
			CFrame.new(hs.X * 0.05, hs.Y * 0.3, -hs.Z * 0.49) * CFrame.Angles(0, 0, math.rad(6))
		)
	end,
	Bun = function(ctx, hs)
		hairPiece(ctx, "Cap", Vector3.new(hs.X * 1.05, hs.Y * 0.26, hs.Z * 1.05), CFrame.new(0, hs.Y * 0.42, 0.02))
		hairPiece(
			ctx,
			"Back",
			Vector3.new(hs.X * 1.04, hs.Y * 0.6, hs.Z * 0.22),
			CFrame.new(0, hs.Y * 0.12, hs.Z * 0.42)
		)
		hairPiece(
			ctx,
			"Fringe",
			Vector3.new(hs.X * 0.55, hs.Y * 0.2, hs.Z * 0.15),
			CFrame.new(-hs.X * 0.22, hs.Y * 0.3, -hs.Z * 0.48) * CFrame.Angles(0, 0, math.rad(-12))
		)
		add(ctx, "Head", "HairBun", {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * hs.Y * 0.45,
			Color = ctx.Design.Hair,
			Material = Enum.Material.SmoothPlastic,
		}, CFrame.new(0, hs.Y * 0.38, hs.Z * 0.55))
	end,
	None = function() end,
}

-- Draws a simple face (brows, eyes, mouth) on the front of the head, so
-- characters don't wear the default Roblox smile.
local function drawFace(ctx: Ctx)
	local head = ctx.Parts.Head
	if not head then
		return
	end
	for _, child in head:GetChildren() do
		if child:IsA("Decal") and child.Name == "face" then
			child:Destroy()
		end
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "OutfitFace"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(100, 100)
	gui.LightInfluence = 1
	gui.Parent = head

	local function feature(name: string, x: number, y: number, w: number, h: number, color: Color3, rotation: number?)
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.Rotation = rotation or 0
		f.Parent = gui
	end
	local d = ctx.Design
	local browColor = darker(d.Hair, 0.1)
	feature("BrowL", 0.32, 0.38, 0.18, 0.04, browColor, -6)
	feature("BrowR", 0.68, 0.38, 0.18, 0.04, browColor, 6)
	feature("EyeWhiteL", 0.33, 0.47, 0.13, 0.08, Color3.fromRGB(235, 232, 226))
	feature("EyeWhiteR", 0.67, 0.47, 0.13, 0.08, Color3.fromRGB(235, 232, 226))
	feature("EyeL", 0.34, 0.47, 0.07, 0.08, d.Eyes)
	feature("EyeR", 0.66, 0.47, 0.07, 0.08, d.Eyes)
	feature("Nose", 0.5, 0.6, 0.05, 0.08, darker(d.Skin, 0.15))
	feature("Mouth", 0.5, 0.74, 0.2, 0.025, darker(d.Skin, 0.4))
end

