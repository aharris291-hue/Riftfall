		BackgroundColor3 = Color3.fromRGB(70, 60, 48),
		Font = FONT_BOLD,
		TextSize = 16,
		TextColor3 = COLORS.Text,
		Text = "Close (Enter)",
		ZIndex = 11,
		Parent = noteFrame,
	}, { corner(6) })
	close.Activated:Connect(function()
		noteFrame.Visible = false
		ClientState.ModalOpen = false
	end)
end

local function buildDeathScreen()
