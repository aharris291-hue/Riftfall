      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[--!strict
-- PlayerData: the server's record of each player's run. The client never
-- writes to this directly; it can only ask (through RemoteEvents) and the
-- server decides.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

export type Slot = { Id: string, Count: number }

export type Data = {
	Inventory: { Slot? },
	Battery: number,
	CheckpointOrder: number,
	CheckpointSpawn: Vector3?,
	Deaths: number,
	NotesRead: { [string]: boolean },
	StartTime: number,
	Finished: boolean,
	Busy: boolean, -- True while an item use is in progress.
	LastUse: number,
	LastRequest: { [string]: number }, -- Per-remote rate limiting.
}

local PlayerData = {}

local records: { [Player]: Data } = {}

local function newData(): Data
	return {
		Inventory = {},
		Battery = Config.Flashlight.StartingBattery,
		CheckpointOrder = 0,
		CheckpointSpawn = nil,
		Deaths = 0,
		NotesRead = {},
		StartTime = os.clock(),
		Finished = false,
		Busy = false,
		LastUse = 0,
		LastRequest = {},
	}
end

local reset: (Player) -> Data

-- Returns the player's record, creating it on first use (so services do not
-- depend on the order their PlayerAdded handlers run in). Nil once the
-- player has left.
function PlayerData.Get(player: Player): Data?
	local data = records[player]
	if not data and player.Parent == Players then
		data = reset(player)
	end
	return data
end

function PlayerData.Reset(player: Player): Data
	return reset(player)
end

function reset(player: Player): Data
	local data = newData()
	records[player] = data
	player:SetAttribute("Battery", data.Battery)
	player:SetAttribute("FlashlightOn", false)
	player:SetAttribute("Crouching", false)
	return data
end

-- Returns true if the player may use `action` now; false if too soon.
-- Cheap protection against remote spam from modified clients.
function PlayerData.RateLimit(player: Player, action: string, interval: number): boolean
	local data = records[player]
	if not data then
		return false
	end
	local now = os.clock()
	local last = data.LastRequest[action]
	if last and now - last < interval then
		return false
	end
	data.LastRequest[action] = now
	return true
end

-- Returns the player's living character parts, or nil if not alive.
function PlayerData.GetAliveCharacter(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return character, humanoid, root
	end
	return nil, nil, nil
end

function PlayerData.Init()
	Players.PlayerAdded:Connect(function(player)
		PlayerData.Get(player)
	end)
	for _, player in Players:GetPlayers() do
		PlayerData.Get(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		records[player] = nil
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Zones</string>
            <string name="Source"><![CDATA[--!strict
-- Zones: small helpers for "is this point inside that box?" checks and for
-- binding code to tagged instances (including ones created later, e.g. when
-- the level is rebuilt for Play Again).

local CollectionService = game:GetService("CollectionService")

local Zones = {}

-- True if a world position lies inside a part's (possibly rotated) box.
function Zones.Contains(part: BasePart, point: Vector3): boolean
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local half = part.Size / 2
	return math.abs(localPoint.X) <= half.X and math.abs(localPoint.Y) <= half.Y and math.abs(localPoint.Z) <= half.Z
end

-- True if the point is inside any part carrying the given tag.
function Zones.InAnyTagged(tag: string, point: Vector3): boolean
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") and Zones.Contains(inst, point) then
			return true
		end
	end
	return false
end

-- Calls `callback` for every instance with `tag`, now and in the future.
function Zones.BindTag(tag: string, callback: (Instance) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(callback, inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(callback)
end

-- First tagged BasePart (used for single markers such as spawn points).
function Zones.FirstTagged(tag: string): BasePart?
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			return inst
		end
	end
	return nil
end

return Zones
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
